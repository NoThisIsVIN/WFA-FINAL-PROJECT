  "sweeps": [
    {
      "name": "TariffRate UNIQUE never overlaps: inverter kW 0..150 x contract dates",
      "decisionId": "TariffRate",
      "variables": {
        "contractDate": "2026-11-02",
        "system": {
          "pvKw": 6.5,
          "inverterKw": 5,
          "batteryKwh": 0,
          "batteryKw": 0
        }
      },
      "vary": {
        "system.inverterKw": {
          "from": 0,
          "to": 150,
          "step": 0.5
        },
        "contractDate": [
          "2026-03-31",
          "2026-04-01",
          "2026-11-02",
          "2027-03-31",
          "2027-04-01",
          "2027-10-15",
          "2028-03-31",
          "2028-04-01"
        ]
      },
      "assert": "noFailure"
    },
