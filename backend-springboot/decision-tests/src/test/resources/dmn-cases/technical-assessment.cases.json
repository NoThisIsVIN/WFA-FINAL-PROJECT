  "sweeps": [
    {
      "name": "GridLoadStatus always gives a status from 0 to 200 %",
      "decisionId": "GridLoadStatus",
      "vary": {
        "projectedLoadPct": {
          "from": 0,
          "to": 200,
          "step": 0.5
        }
      },
      "assert": "nonNull"
    },
    {
      "name": "FallbackYield never fails for known and unknown regions",
      "decisionId": "FallbackYield",
      "vary": {
        "site.region": [
          "NORTH",
          "SOUTH",
          "EAST",
          "WEST",
          "CENTRAL",
          "MARS",
          ""
        ]
      },
      "assert": "noFailure"
    }
  ]
