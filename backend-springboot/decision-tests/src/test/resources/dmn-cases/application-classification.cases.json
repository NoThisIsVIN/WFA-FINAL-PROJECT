  "sweeps": [
    {
      "name": "SizeClass has no gaps or overlaps from -10 to 300 kW",
      "decisionId": "SizeClass",
      "vary": {
        "system.inverterKw": {
          "from": -10,
          "to": 300,
          "step": 0.25
        }
      },
      "assert": "nonNull"
    },
    {
      "name": "ApplicationClassification never fails for any size and applicant type",
      "decisionId": "ApplicationClassification",
      "vary": {
        "system.inverterKw": {
          "from": 0,
          "to": 200,
          "step": 0.5
        },
        "applicant.type": [
          "HOME",
          "FACTORY",
          "OTHER"
        ]
      },
      "assert": "nonNull"
    }
  ]
