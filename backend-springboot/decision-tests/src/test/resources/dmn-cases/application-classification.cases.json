{
  "dmnFile": "application-classification.dmn",
  "cases": [
    {
      "name": "MICRO home 0.8 kW -> self declaration only, fee 0, LOW",
      "decisionId": "ApplicationClassification",
      "variables": {
        "system": {
          "pvKw": 0.96,
          "inverterKw": 0.8,
          "batteryKwh": 0,
          "batteryKw": 0
        },
        "applicant": {
          "name": "Test Applicant",
          "email": "test@example.test",
          "type": "HOME"
        },
        "hasBattery": false
      },
      "expected": {
        "sizeClass": "MICRO",
        "requiredDocuments": [
          "SELF_DECLARATION"
        ],
        "connectionFeeRs": 0,
        "priority": "LOW"
      },
      "expectedMatchedRules": {
        "SizeClass": [
          "SizeClass_Micro"
        ],
        "RequiredDocuments": [
          "RequiredDocuments_SelfDeclaration"
        ],
        "ConnectionFee": [
          "ConnectionFee_Micro"
        ],
        "CasePriority": [
          "CasePriority_MicroLow"
        ]
      },
      "refs": [
        "F07"
      ]
    },
