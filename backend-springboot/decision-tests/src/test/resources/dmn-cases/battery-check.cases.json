    {
      "name": "Home 4 kW / 10 kWh battery on 5 kW inverter, certified -> true",
      "decisionId": "BatteryCheck",
      "variables": {
        "applicant": {
          "name": "Asha Rao",
          "type": "HOME"
        },
        "system": {
          "pvKw": 6.5,
          "inverterKw": 5,
          "batteryKwh": 10,
          "batteryKw": 4
        },
        "devices": [
          {
            "serialNumber": "INV-001",
            "type": "INVERTER",
            "model": "SunMax 5K",
            "certificateId": "CERT-INV-001"
          },
          {
            "serialNumber": "BAT-001",
            "type": "BATTERY",
            "model": "PowerCell 10",
            "certificateId": "CERT-BAT-001"
          }
        ]
      },
      "expected": true,
      "expectedMatchedRules": {
        "BatteryCheck": [
          "BatteryCheck_AllPassed"
        ]
      }
    },
