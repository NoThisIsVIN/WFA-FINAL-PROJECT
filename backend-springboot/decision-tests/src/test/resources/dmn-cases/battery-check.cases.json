  "sweeps": [
    {
      "name": "BatteryCheck never fails: battery kW 0..10 x battery kWh values (HOME)",
      "decisionId": "BatteryCheck",
      "variables": {
        "applicant": {
          "name": "Asha Rao",
          "type": "HOME"
        },
        "system": {
          "pvKw": 6.5,
          "inverterKw": 5,
          "batteryKwh": 10,
          "batteryKw": 4
        },
        "devices": [
          {
            "serialNumber": "INV-001",
            "type": "INVERTER",
            "model": "SunMax 5K",
            "certificateId": "CERT-INV-001"
          },
          {
            "serialNumber": "BAT-001",
            "type": "BATTERY",
            "model": "PowerCell 10",
            "certificateId": "CERT-BAT-001"
          }
        ]
      },
      "vary": {
        "system.batteryKw": {
          "from": 0,
          "to": 10,
          "step": 0.5
        },
        "system.batteryKwh": [
          0,
          10,
          29.9,
          30,
          30.1,
          2000,
          2001,
          null
        ]
      },
      "assert": "noFailure"
    },
    {
      "name": "BatteryCheck never fails: battery kWh 0..2100 x applicant type",
      "decisionId": "BatteryCheck",
      "variables": {
        "applicant": {
          "name": "Asha Rao",
          "type": "HOME"
        },
        "system": {
          "pvKw": 6.5,
          "inverterKw": 5,
          "batteryKwh": 10,
          "batteryKw": 4
        },
        "devices": [
          {
            "serialNumber": "INV-001",
            "type": "INVERTER",
            "model": "SunMax 5K",
            "certificateId": "CERT-INV-001"
          },
          {
            "serialNumber": "BAT-001",
            "type": "BATTERY",
            "model": "PowerCell 10",
            "certificateId": "CERT-BAT-001"
          }
        ]
      },
      "vary": {
        "system.batteryKwh": {
          "from": 0,
          "to": 2100,
          "step": 25
        },
        "applicant.type": [
          "HOME",
          "FACTORY",
          "OTHER",
          null
        ]
      },
      "assert": "noFailure"
    }
