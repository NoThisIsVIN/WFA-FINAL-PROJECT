<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_S5" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:error id="Error_DeviceFatal" name="Device fatal" errorCode="DEVICE_FATAL" />
  <bpmn:process id="spike-s5-mi-completion" name="Spike S5 parallel MI with completion condition" isExecutable="true">
    <bpmn:startEvent id="Start" name="Start">
      <bpmn:outgoing>Flow_Start_MI</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="MI_SP" name="Test each device">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="result" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_MI</bpmn:incoming>
      <bpmn:outgoing>Flow_MI_After</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=devices" inputElement="device" outputCollection="results" outputElement="=result" />
        </bpmn:extensionElements>
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">=count(results[item != null and item.status = "FAILED"]) &gt;= 2</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="SP_Start" name="Device start">
        <bpmn:outgoing>Flow_SPStart_Test</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="TestDevice" name="Test device">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="spike-s5-test" />
          <zeebe:ioMapping>
            <zeebe:input source="=device" target="device" />
            <zeebe:input source="=loopCounter" target="seenLoopCounter" />
            <zeebe:input source="=results" target="seenResults" />
            <zeebe:input source="=numberOfInstances" target="seenNumberOfInstances" />
            <zeebe:input source="=numberOfCompletedInstances" target="seenNumberOfCompletedInstances" />
            <zeebe:input source="=numberOfActiveInstances" target="seenNumberOfActiveInstances" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SPStart_Test</bpmn:incoming>
        <bpmn:outgoing>Flow_Test_Xor</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="XorFatal" name="Fatal?" default="Flow_Xor_SPEnd">
        <bpmn:incoming>Flow_Test_Xor</bpmn:incoming>
        <bpmn:outgoing>Flow_Xor_SPEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_Xor_ErrEnd</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SP_End" name="Device done">
        <bpmn:incoming>Flow_Xor_SPEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="ErrEnd" name="Device fatal">
        <bpmn:incoming>Flow_Xor_ErrEnd</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrDef_End" errorRef="Error_DeviceFatal" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SPStart_Test" sourceRef="SP_Start" targetRef="TestDevice" />
      <bpmn:sequenceFlow id="Flow_Test_Xor" sourceRef="TestDevice" targetRef="XorFatal" />
      <bpmn:sequenceFlow id="Flow_Xor_SPEnd" name="no" sourceRef="XorFatal" targetRef="SP_End" />
      <bpmn:sequenceFlow id="Flow_Xor_ErrEnd" name="yes" sourceRef="XorFatal" targetRef="ErrEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=result != null and result.status = "FATAL"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="MI_Err" name="Device fatal caught" attachedToRef="MI_SP">
      <bpmn:outgoing>Flow_Err_Fatal</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Boundary" errorRef="Error_DeviceFatal" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="AfterMI" name="After MI">
      <bpmn:extensionElements><zeebe:taskDefinition type="spike-s5-after" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_MI_After</bpmn:incoming>
      <bpmn:outgoing>Flow_After_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="End">
      <bpmn:incoming>Flow_After_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="HandleFatal" name="Handle fatal">
      <bpmn:extensionElements><zeebe:taskDefinition type="spike-s5-fatal" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Err_Fatal</bpmn:incoming>
      <bpmn:outgoing>Flow_Fatal_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Fatal" name="Ended fatal">
      <bpmn:incoming>Flow_Fatal_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_MI" sourceRef="Start" targetRef="MI_SP" />
    <bpmn:sequenceFlow id="Flow_MI_After" sourceRef="MI_SP" targetRef="AfterMI" />
    <bpmn:sequenceFlow id="Flow_After_End" sourceRef="AfterMI" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_Err_Fatal" sourceRef="MI_Err" targetRef="HandleFatal" />
    <bpmn:sequenceFlow id="Flow_Fatal_End" sourceRef="HandleFatal" targetRef="End_Fatal" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_S5">
    <bpmndi:BPMNPlane id="Plane_S5" bpmnElement="spike-s5-mi-completion">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="152" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MI_SP_di" bpmnElement="MI_SP" isExpanded="true"><dc:Bounds x="240" y="100" width="560" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_Start_di" bpmnElement="SP_Start"><dc:Bounds x="272" y="192" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TestDevice_di" bpmnElement="TestDevice"><dc:Bounds x="350" y="170" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XorFatal_di" bpmnElement="XorFatal" isMarkerVisible="true"><dc:Bounds x="505" y="185" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_End_di" bpmnElement="SP_End"><dc:Bounds x="652" y="192" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ErrEnd_di" bpmnElement="ErrEnd"><dc:Bounds x="652" y="272" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MI_Err_di" bpmnElement="MI_Err"><dc:Bounds x="742" y="322" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AfterMI_di" bpmnElement="AfterMI"><dc:Bounds x="860" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1022" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HandleFatal_di" bpmnElement="HandleFatal"><dc:Bounds x="860" y="400" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Fatal_di" bpmnElement="End_Fatal"><dc:Bounds x="1022" y="422" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_MI_di" bpmnElement="Flow_Start_MI"><di:waypoint x="188" y="220" /><di:waypoint x="240" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SPStart_Test_di" bpmnElement="Flow_SPStart_Test"><di:waypoint x="308" y="210" /><di:waypoint x="350" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Test_Xor_di" bpmnElement="Flow_Test_Xor"><di:waypoint x="450" y="210" /><di:waypoint x="505" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Xor_SPEnd_di" bpmnElement="Flow_Xor_SPEnd"><di:waypoint x="555" y="210" /><di:waypoint x="652" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Xor_ErrEnd_di" bpmnElement="Flow_Xor_ErrEnd"><di:waypoint x="530" y="235" /><di:waypoint x="530" y="290" /><di:waypoint x="652" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MI_After_di" bpmnElement="Flow_MI_After"><di:waypoint x="800" y="220" /><di:waypoint x="860" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_After_End_di" bpmnElement="Flow_After_End"><di:waypoint x="960" y="220" /><di:waypoint x="1022" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Err_Fatal_di" bpmnElement="Flow_Err_Fatal"><di:waypoint x="760" y="358" /><di:waypoint x="760" y="440" /><di:waypoint x="860" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fatal_End_di" bpmnElement="Flow_Fatal_End"><di:waypoint x="960" y="440" /><di:waypoint x="1022" y="440" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
