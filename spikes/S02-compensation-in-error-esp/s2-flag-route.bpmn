<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_S2_flag" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:error id="Error_Validation" name="Validation failed" errorCode="VALIDATION_FAILED" />
  <bpmn:process id="spike-s2-flag-route" name="Spike S2 fallback - error ESP compensates, sets flag, XOR after SP" isExecutable="true">
    <bpmn:startEvent id="Start" name="Start">
      <bpmn:outgoing>Flow_Start_SP</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SP" name="Reservation sub-process">
      <bpmn:incoming>Flow_Start_SP</bpmn:incoming>
      <bpmn:outgoing>Flow_SP_Gw</bpmn:outgoing>
      <bpmn:startEvent id="SP_Start" name="SP start">
        <bpmn:outgoing>Flow_SPStart_Reserve</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Reserve" name="Reserve capacity">
        <bpmn:extensionElements><zeebe:taskDefinition type="spike-s2-reserve" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_SPStart_Reserve</bpmn:incoming>
        <bpmn:outgoing>Flow_Reserve_Validate</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="Reserve_Comp" name="Compensate reserve" attachedToRef="Reserve">
        <bpmn:compensateEventDefinition id="CompDef_Reserve" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="CancelReserve" name="Cancel reservation" isForCompensation="true">
        <bpmn:extensionElements><zeebe:taskDefinition type="spike-s2-cancel-reserve" /></bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Validate" name="Validate (throws error)">
        <bpmn:extensionElements><zeebe:taskDefinition type="spike-s2-validate" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_Reserve_Validate</bpmn:incoming>
        <bpmn:outgoing>Flow_Validate_SPEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="SP_End" name="SP end">
        <bpmn:incoming>Flow_Validate_SPEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SPStart_Reserve" sourceRef="SP_Start" targetRef="Reserve" />
      <bpmn:sequenceFlow id="Flow_Reserve_Validate" sourceRef="Reserve" targetRef="Validate" />
      <bpmn:sequenceFlow id="Flow_Validate_SPEnd" sourceRef="Validate" targetRef="SP_End" />
      <bpmn:subProcess id="ErrESP" name="Validation error handler" triggeredByEvent="true">
        <bpmn:startEvent id="ErrESP_Start" name="Validation failed">
          <bpmn:outgoing>Flow_ErrStart_Comp</bpmn:outgoing>
          <bpmn:errorEventDefinition id="ErrDef_Start" errorRef="Error_Validation" />
        </bpmn:startEvent>
        <bpmn:intermediateThrowEvent id="CompThrow" name="Compensate">
          <bpmn:incoming>Flow_ErrStart_Comp</bpmn:incoming>
          <bpmn:outgoing>Flow_Comp_Mark</bpmn:outgoing>
          <bpmn:compensateEventDefinition id="CompDef_Throw" waitForCompletion="true" />
        </bpmn:intermediateThrowEvent>
        <bpmn:scriptTask id="MarkFailed" name="Mark SP failed">
          <bpmn:extensionElements><zeebe:script expression="=true" resultVariable="spFailed" /></bpmn:extensionElements>
          <bpmn:incoming>Flow_Comp_Mark</bpmn:incoming>
          <bpmn:outgoing>Flow_Mark_End</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:endEvent id="ErrESP_End" name="Handler done">
          <bpmn:incoming>Flow_Mark_End</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_ErrStart_Comp" sourceRef="ErrESP_Start" targetRef="CompThrow" />
        <bpmn:sequenceFlow id="Flow_Comp_Mark" sourceRef="CompThrow" targetRef="MarkFailed" />
        <bpmn:sequenceFlow id="Flow_Mark_End" sourceRef="MarkFailed" targetRef="ErrESP_End" />
      </bpmn:subProcess>
      <bpmn:association id="Assoc_Reserve" associationDirection="One" sourceRef="Reserve_Comp" targetRef="CancelReserve" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gw_Failed" name="SP failed?" default="Flow_Gw_OK">
      <bpmn:incoming>Flow_SP_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Gw_Handle</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gw_OK</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="HandleFailure" name="Handle failure">
      <bpmn:extensionElements><zeebe:taskDefinition type="spike-s2-handle" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Gw_Handle</bpmn:incoming>
      <bpmn:outgoing>Flow_Handle_EndFailed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Failed" name="Ended failed">
      <bpmn:incoming>Flow_Handle_EndFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_OK" name="Ended OK">
      <bpmn:incoming>Flow_Gw_OK</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_SP" sourceRef="Start" targetRef="SP" />
    <bpmn:sequenceFlow id="Flow_SP_Gw" sourceRef="SP" targetRef="Gw_Failed" />
    <bpmn:sequenceFlow id="Flow_Gw_Handle" name="yes" sourceRef="Gw_Failed" targetRef="HandleFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=spFailed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gw_OK" name="no" sourceRef="Gw_Failed" targetRef="End_OK" />
    <bpmn:sequenceFlow id="Flow_Handle_EndFailed" sourceRef="HandleFailure" targetRef="End_Failed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_S2_flag">
    <bpmndi:BPMNPlane id="Plane_S2_flag" bpmnElement="spike-s2-flag-route">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="152" y="252" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_di" bpmnElement="SP" isExpanded="true"><dc:Bounds x="240" y="80" width="620" height="380" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_Start_di" bpmnElement="SP_Start"><dc:Bounds x="272" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reserve_di" bpmnElement="Reserve"><dc:Bounds x="350" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reserve_Comp_di" bpmnElement="Reserve_Comp"><dc:Bounds x="382" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CancelReserve_di" bpmnElement="CancelReserve"><dc:Bounds x="350" y="240" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validate_di" bpmnElement="Validate"><dc:Bounds x="520" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_End_di" bpmnElement="SP_End"><dc:Bounds x="702" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ErrESP_di" bpmnElement="ErrESP" isExpanded="true"><dc:Bounds x="280" y="340" width="540" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ErrESP_Start_di" bpmnElement="ErrESP_Start"><dc:Bounds x="312" y="377" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CompThrow_di" bpmnElement="CompThrow"><dc:Bounds x="412" y="377" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MarkFailed_di" bpmnElement="MarkFailed"><dc:Bounds x="510" y="355" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ErrESP_End_di" bpmnElement="ErrESP_End"><dc:Bounds x="702" y="377" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Failed_di" bpmnElement="Gw_Failed" isMarkerVisible="true"><dc:Bounds x="915" y="245" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HandleFailure_di" bpmnElement="HandleFailure"><dc:Bounds x="1030" y="130" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Failed_di" bpmnElement="End_Failed"><dc:Bounds x="1192" y="152" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OK_di" bpmnElement="End_OK"><dc:Bounds x="1192" y="322" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_SP_di" bpmnElement="Flow_Start_SP"><di:waypoint x="188" y="270" /><di:waypoint x="240" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SPStart_Reserve_di" bpmnElement="Flow_SPStart_Reserve"><di:waypoint x="308" y="160" /><di:waypoint x="350" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reserve_Validate_di" bpmnElement="Flow_Reserve_Validate"><di:waypoint x="450" y="160" /><di:waypoint x="520" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validate_SPEnd_di" bpmnElement="Flow_Validate_SPEnd"><di:waypoint x="620" y="160" /><di:waypoint x="702" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_Reserve_di" bpmnElement="Assoc_Reserve"><di:waypoint x="400" y="218" /><di:waypoint x="400" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ErrStart_Comp_di" bpmnElement="Flow_ErrStart_Comp"><di:waypoint x="348" y="395" /><di:waypoint x="412" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Comp_Mark_di" bpmnElement="Flow_Comp_Mark"><di:waypoint x="448" y="395" /><di:waypoint x="510" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Mark_End_di" bpmnElement="Flow_Mark_End"><di:waypoint x="610" y="395" /><di:waypoint x="702" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SP_Gw_di" bpmnElement="Flow_SP_Gw"><di:waypoint x="860" y="270" /><di:waypoint x="915" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gw_Handle_di" bpmnElement="Flow_Gw_Handle"><di:waypoint x="940" y="245" /><di:waypoint x="940" y="170" /><di:waypoint x="1030" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gw_OK_di" bpmnElement="Flow_Gw_OK"><di:waypoint x="940" y="295" /><di:waypoint x="940" y="340" /><di:waypoint x="1192" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Handle_EndFailed_di" bpmnElement="Flow_Handle_EndFailed"><di:waypoint x="1130" y="170" /><di:waypoint x="1192" y="170" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
