<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_S4" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="spike-s4-inclusive-join" name="Spike S4 inclusive fork/join" isExecutable="true">
    <bpmn:startEvent id="Start" name="Start">
      <bpmn:outgoing>Flow_Start_Fork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:inclusiveGateway id="Fork" name="Which checks?" default="Flow_Default">
      <bpmn:incoming>Flow_Start_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_A</bpmn:outgoing>
      <bpmn:outgoing>Flow_B</bpmn:outgoing>
      <bpmn:outgoing>Flow_C</bpmn:outgoing>
      <bpmn:outgoing>Flow_Default</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="TaskA" name="Check A">
      <bpmn:extensionElements><zeebe:taskDefinition type="spike-s4-a" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TaskB" name="Check B">
      <bpmn:extensionElements><zeebe:taskDefinition type="spike-s4-b" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_B</bpmn:incoming>
      <bpmn:outgoing>Flow_B_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="XorC" name="C fast track?" default="Flow_XorC_TaskC">
      <bpmn:incoming>Flow_C</bpmn:incoming>
      <bpmn:outgoing>Flow_XorC_Join</bpmn:outgoing>
      <bpmn:outgoing>Flow_XorC_TaskC</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TaskC" name="Check C">
      <bpmn:extensionElements><zeebe:taskDefinition type="spike-s4-c" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_XorC_TaskC</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TaskDefault" name="Default check">
      <bpmn:extensionElements><zeebe:taskDefinition type="spike-s4-default" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Default</bpmn:incoming>
      <bpmn:outgoing>Flow_Default_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="Join" name="Checks done">
      <bpmn:incoming>Flow_A_Join</bpmn:incoming>
      <bpmn:incoming>Flow_B_Join</bpmn:incoming>
      <bpmn:incoming>Flow_XorC_Join</bpmn:incoming>
      <bpmn:incoming>Flow_C_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Default_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_After</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="After" name="After join">
      <bpmn:extensionElements><zeebe:taskDefinition type="spike-s4-after" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Join_After</bpmn:incoming>
      <bpmn:outgoing>Flow_After_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="End">
      <bpmn:incoming>Flow_After_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Fork" sourceRef="Start" targetRef="Fork" />
    <bpmn:sequenceFlow id="Flow_A" name="needA" sourceRef="Fork" targetRef="TaskA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=needA = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B" name="needB" sourceRef="Fork" targetRef="TaskB">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=needB = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C" name="needC" sourceRef="Fork" targetRef="XorC">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=needC = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Default" name="none" sourceRef="Fork" targetRef="TaskDefault" />
    <bpmn:sequenceFlow id="Flow_A_Join" sourceRef="TaskA" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_B_Join" sourceRef="TaskB" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_XorC_Join" name="fast" sourceRef="XorC" targetRef="Join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fastC = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_XorC_TaskC" name="full" sourceRef="XorC" targetRef="TaskC" />
    <bpmn:sequenceFlow id="Flow_C_Join" sourceRef="TaskC" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_Default_Join" sourceRef="TaskDefault" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_Join_After" sourceRef="Join" targetRef="After" />
    <bpmn:sequenceFlow id="Flow_After_End" sourceRef="After" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_S4">
    <bpmndi:BPMNPlane id="Plane_S4" bpmnElement="spike-s4-inclusive-join">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="152" y="302" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fork_di" bpmnElement="Fork"><dc:Bounds x="235" y="295" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskA_di" bpmnElement="TaskA"><dc:Bounds x="380" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskB_di" bpmnElement="TaskB"><dc:Bounds x="380" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XorC_di" bpmnElement="XorC" isMarkerVisible="true"><dc:Bounds x="355" y="335" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskC_di" bpmnElement="TaskC"><dc:Bounds x="470" y="400" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskDefault_di" bpmnElement="TaskDefault"><dc:Bounds x="380" y="520" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join"><dc:Bounds x="655" y="295" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="After_di" bpmnElement="After"><dc:Bounds x="760" y="280" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="922" y="302" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Fork_di" bpmnElement="Flow_Start_Fork"><di:waypoint x="188" y="320" /><di:waypoint x="235" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_di" bpmnElement="Flow_A"><di:waypoint x="260" y="295" /><di:waypoint x="260" y="120" /><di:waypoint x="380" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B_di" bpmnElement="Flow_B"><di:waypoint x="260" y="295" /><di:waypoint x="260" y="240" /><di:waypoint x="380" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C_di" bpmnElement="Flow_C"><di:waypoint x="260" y="345" /><di:waypoint x="260" y="360" /><di:waypoint x="355" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Default_di" bpmnElement="Flow_Default"><di:waypoint x="260" y="345" /><di:waypoint x="260" y="560" /><di:waypoint x="380" y="560" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A_Join_di" bpmnElement="Flow_A_Join"><di:waypoint x="480" y="120" /><di:waypoint x="680" y="120" /><di:waypoint x="680" y="295" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B_Join_di" bpmnElement="Flow_B_Join"><di:waypoint x="480" y="240" /><di:waypoint x="680" y="240" /><di:waypoint x="680" y="295" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_XorC_Join_di" bpmnElement="Flow_XorC_Join"><di:waypoint x="405" y="360" /><di:waypoint x="600" y="360" /><di:waypoint x="600" y="320" /><di:waypoint x="655" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_XorC_TaskC_di" bpmnElement="Flow_XorC_TaskC"><di:waypoint x="380" y="385" /><di:waypoint x="380" y="440" /><di:waypoint x="470" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C_Join_di" bpmnElement="Flow_C_Join"><di:waypoint x="570" y="440" /><di:waypoint x="680" y="440" /><di:waypoint x="680" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Default_Join_di" bpmnElement="Flow_Default_Join"><di:waypoint x="480" y="560" /><di:waypoint x="680" y="560" /><di:waypoint x="680" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_After_di" bpmnElement="Flow_Join_After"><di:waypoint x="705" y="320" /><di:waypoint x="760" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_After_End_di" bpmnElement="Flow_After_End"><di:waypoint x="860" y="320" /><di:waypoint x="922" y="320" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
