<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="solar-connection-approval-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collab_SolarConnection">
    <bpmn:participant id="Participant_Applicant" name="Applicant (React portal)" />
    <bpmn:participant id="Participant_Utility" name="Metro City Power: solar connection approval" processRef="solar-connection-approval" />
    <bpmn:participant id="Participant_External" name="External services (weather API, SMTP)" />
    <bpmn:messageFlow id="MF_Submit" name="Submit form" sourceRef="Participant_Applicant" targetRef="Start_Applied" />
    <bpmn:messageFlow id="MF_FixReq" name="Fix request" sourceRef="Sub_Intake" targetRef="Participant_Applicant" />
    <bpmn:messageFlow id="MF_FixReply" name="Corrected data" sourceRef="Participant_Applicant" targetRef="Sub_Intake" />
    <bpmn:messageFlow id="MF_Withdraw" name="Withdraw" sourceRef="Participant_Applicant" targetRef="Esp_Withdraw" />
    <bpmn:messageFlow id="MF_Weather" name="Weather API" sourceRef="Sub_Technical" targetRef="Participant_External" />
    <bpmn:messageFlow id="MF_Smtp" name="Certificate email" sourceRef="Sub_Approval" targetRef="Participant_External" />
  </bpmn:collaboration>
  <bpmn:process id="solar-connection-approval" name="Solar connection approval" isExecutable="true">
    <bpmn:extensionElements><zeebe:versionTag value="1.0.0" /></bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Connection desk">
        <bpmn:flowNodeRef>Sub_Intake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Esp_Withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Esp_Deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Esp_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_IntakeClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_B_IntakeClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="System (automation)">
        <bpmn:flowNodeRef>Start_Applied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Setup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Small</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterOnly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Registered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_SmartMeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Connected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZeroExport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoExport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_B_Expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Grid engineer">
        <bpmn:flowNodeRef>Sub_Technical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Overload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Upgrade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_UpMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_TechClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_B_TechClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Field inspector">
        <bpmn:flowNodeRef>Sub_Inspections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Esp_Emergency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_InspClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_B_InspClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Compliance">
        <bpmn:flowNodeRef>Sub_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ApprClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_B_ApprClosed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Applied" name="Application submitted (F01)">
      <bpmn:outgoing>Flow_Start_Applied_Task_Setup</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Msg_Submitted" />
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Setup" name="Set case defaults (timers, config)">
      <bpmn:extensionElements><zeebe:script expression="={
  timers: if demoMode = true
    then {fixReminder: &quot;PT2M&quot;, fixReply: &quot;PT5M&quot;, retryWait: &quot;PT10S&quot;, offerExpiry: &quot;PT5M&quot;, delivery: &quot;PT5M&quot;, inspectionOverdue: &quot;PT3M&quot;, deadlineWarn: &quot;PT20M&quot;, signature: &quot;PT5M&quot;}
    else {fixReminder: &quot;PT72H&quot;, fixReply: &quot;PT168H&quot;, retryWait: &quot;PT30S&quot;, offerExpiry: &quot;PT336H&quot;, delivery: &quot;PT1440H&quot;, inspectionOverdue: &quot;PT120H&quot;, deadlineWarn: &quot;PT432H&quot;, signature: &quot;PT336H&quot;},
  config: {weatherUrl: &quot;https://api.open-meteo.com/v1/forecast&quot;, gridUrl: &quot;http://localhost:8091/grid&quot;, installerUrl: &quot;http://localhost:8091/installers&quot;, certUrl: &quot;http://localhost:8091/certificates&quot;, smtpHost: &quot;127.0.0.1&quot;, smtpPort: 1025, mailFrom: &quot;noreply@metrocitypower.test&quot;},
  hasBattery: system.batteryKwh != null and system.batteryKwh &gt; 0
}" resultVariable="setup" /><zeebe:ioMapping><zeebe:output source="=setup.timers" target="timers" /><zeebe:output source="=setup.config" target="config" /><zeebe:output source="=setup.hasBattery" target="hasBattery" /><zeebe:output source="=false" target="exportLimited" /></zeebe:ioMapping></bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Applied_Task_Setup</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Setup_Sub_Intake</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:subProcess id="Sub_Intake" name="Intake (F02-05)">
      <bpmn:extensionElements><zeebe:ioMapping><zeebe:input source="=0" target="fixRound" /></zeebe:ioMapping></bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_Setup_Sub_Intake</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Intake_Sub_Classify</bpmn:outgoing>
      <bpmn:startEvent id="I_Start" name="Intake started">
        <bpmn:outgoing>Flow_I_Start_I_LoopMerge</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="I_LoopMerge">
        <bpmn:incoming>Flow_I_Start_I_LoopMerge</bpmn:incoming>
        <bpmn:incoming>Flow_I_WaitFix_I_LoopMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_I_LoopMerge_I_Validate</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_Validate" name="Validate application">
        <bpmn:extensionElements><zeebe:taskDefinition type="application-validate" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_I_LoopMerge_I_Validate</bpmn:incoming>
        <bpmn:outgoing>Flow_I_Validate_I_Installer</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="I_BDup" name="Duplicate (F02)" attachedToRef="I_Validate">
        <bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=&quot;DUPLICATE&quot;" target="closeReason" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:outgoing>Flow_I_BDup_I_EndDup</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_2" errorRef="Error_Duplicate" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="I_EndDup" name="Closed: duplicate">
        <bpmn:incoming>Flow_I_BDup_I_EndDup</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_3" errorRef="Error_Closed" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="I_Installer" name="Check installer (registry)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source="=config.installerUrl + &quot;/&quot; + installer.licenseNo" target="url" /><zeebe:input source="false" target="storeResponse" /><zeebe:input source="false" target="followRedirects" /><zeebe:input source="10" target="connectionTimeoutInSeconds" /><zeebe:input source="10" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="13" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" /><zeebe:header key="resultExpression" value="={installerCheck: response.body}" /><zeebe:header key="retryBackoff" value="PT10S" /><zeebe:header key="errorExpression" value="=if error != null and error.code = &quot;404&quot; then bpmnError(&quot;INSTALLER_NOT_FOUND&quot;, &quot;Installer not registered&quot;) else if error = null and list contains([&quot;EXPIRED&quot;, &quot;SUSPENDED&quot;], response.body.status) then bpmnError(&quot;INSTALLER_NOT_FOUND&quot;, &quot;Installer licence &quot; + response.body.status) else null" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_I_Validate_I_Installer</bpmn:incoming>
        <bpmn:outgoing>Flow_I_Installer_I_InstMerge</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="I_BInst" name="Not registered (F05)" attachedToRef="I_Installer">
        <bpmn:outgoing>Flow_I_BInst_I_Flag</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_4" errorRef="Error_Installer" />
      </bpmn:boundaryEvent>
      <bpmn:scriptTask id="I_Flag" name="Mark: needs registered installer">
        <bpmn:extensionElements><zeebe:script expression="=context put(if validation = null then {complete: false, missing: []} else validation, &quot;complete&quot;, false)" resultVariable="validation" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_I_BInst_I_Flag</bpmn:incoming>
        <bpmn:outgoing>Flow_I_Flag_I_InstMerge</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="I_InstMerge">
        <bpmn:incoming>Flow_I_Flag_I_InstMerge</bpmn:incoming>
        <bpmn:incoming>Flow_I_Installer_I_InstMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_I_InstMerge_I_Complete</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="I_Complete" name="Complete?" default="Flow_I_Complete_I_Rounds">
        <bpmn:incoming>Flow_I_InstMerge_I_Complete</bpmn:incoming>
        <bpmn:outgoing>Flow_I_Complete_I_EndOk</bpmn:outgoing>
        <bpmn:outgoing>Flow_I_Complete_I_Rounds</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="I_EndOk" name="Intake OK">
        <bpmn:incoming>Flow_I_Complete_I_EndOk</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="I_Rounds" name="Fix rounds left? (F03)" default="Flow_I_Rounds_I_Manual">
        <bpmn:incoming>Flow_I_Complete_I_Rounds</bpmn:incoming>
        <bpmn:outgoing>Flow_I_Rounds_I_SendFix</bpmn:outgoing>
        <bpmn:outgoing>Flow_I_Rounds_I_Manual</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="I_SendFix" name="Send fix request">
        <bpmn:extensionElements><zeebe:taskDefinition type="portal-request" /><zeebe:ioMapping><zeebe:output source="=fixRound + 1" target="fixRound" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="requestType" value="FIX_REQUEST" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_I_Rounds_I_SendFix</bpmn:incoming>
        <bpmn:outgoing>Flow_I_SendFix_I_WaitFix</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="I_WaitFix" name="Wait for corrected details" messageRef="Msg_Fix">
        <bpmn:incoming>Flow_I_SendFix_I_WaitFix</bpmn:incoming>
        <bpmn:outgoing>Flow_I_WaitFix_I_LoopMerge</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="I_BRemind" name="3 days: reminder (F04)" attachedToRef="I_WaitFix" cancelActivity="false">
        <bpmn:outgoing>Flow_I_BRemind_I_Remind</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_5"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=timers.fixReminder</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="I_Remind" name="Send reminder">
        <bpmn:extensionElements><zeebe:taskDefinition type="portal-request" /><zeebe:taskHeaders><zeebe:header key="requestType" value="FIX_REMINDER" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_I_BRemind_I_Remind</bpmn:incoming>
        <bpmn:outgoing>Flow_I_Remind_I_RemEnd</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="I_RemEnd" name="Reminder sent">
        <bpmn:incoming>Flow_I_Remind_I_RemEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="I_BLapse" name="7 days, no reply (F04)" attachedToRef="I_WaitFix">
        <bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=&quot;NO_REPLY&quot;" target="closeReason" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:outgoing>Flow_I_BLapse_I_EndLapsed</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_6"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=timers.fixReply</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="I_EndLapsed" name="Closed: no reply">
        <bpmn:incoming>Flow_I_BLapse_I_EndLapsed</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_7" errorRef="Error_Closed" />
      </bpmn:endEvent>
      <bpmn:userTask id="I_Manual" name="Manual intake review">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="intake-review" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="connection-desk" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_I_Rounds_I_Manual</bpmn:incoming>
        <bpmn:outgoing>Flow_I_Manual_I_ManualOk</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="I_ManualOk" name="Accept?" default="Flow_I_ManualOk_I_EndRejected">
        <bpmn:incoming>Flow_I_Manual_I_ManualOk</bpmn:incoming>
        <bpmn:outgoing>Flow_I_ManualOk_I_EndAccepted</bpmn:outgoing>
        <bpmn:outgoing>Flow_I_ManualOk_I_EndRejected</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="I_EndAccepted" name="Accepted">
        <bpmn:incoming>Flow_I_ManualOk_I_EndAccepted</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="I_EndRejected" name="Closed: rejected">
        <bpmn:incoming>Flow_I_ManualOk_I_EndRejected</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_8" errorRef="Error_Closed" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_I_BDup_I_EndDup" sourceRef="I_BDup" targetRef="I_EndDup" />
      <bpmn:sequenceFlow id="Flow_I_BLapse_I_EndLapsed" sourceRef="I_BLapse" targetRef="I_EndLapsed" />
      <bpmn:sequenceFlow id="Flow_I_Start_I_LoopMerge" sourceRef="I_Start" targetRef="I_LoopMerge" />
      <bpmn:sequenceFlow id="Flow_I_LoopMerge_I_Validate" sourceRef="I_LoopMerge" targetRef="I_Validate" />
      <bpmn:sequenceFlow id="Flow_I_Validate_I_Installer" sourceRef="I_Validate" targetRef="I_Installer" />
      <bpmn:sequenceFlow id="Flow_I_BInst_I_Flag" sourceRef="I_BInst" targetRef="I_Flag" />
      <bpmn:sequenceFlow id="Flow_I_Flag_I_InstMerge" sourceRef="I_Flag" targetRef="I_InstMerge" />
      <bpmn:sequenceFlow id="Flow_I_Installer_I_InstMerge" sourceRef="I_Installer" targetRef="I_InstMerge" />
      <bpmn:sequenceFlow id="Flow_I_InstMerge_I_Complete" sourceRef="I_InstMerge" targetRef="I_Complete" />
      <bpmn:sequenceFlow id="Flow_I_Complete_I_EndOk" name="Yes" sourceRef="I_Complete" targetRef="I_EndOk">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validation != null and validation.complete = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_I_Complete_I_Rounds" name="No" sourceRef="I_Complete" targetRef="I_Rounds" />
      <bpmn:sequenceFlow id="Flow_I_Rounds_I_SendFix" name="Yes" sourceRef="I_Rounds" targetRef="I_SendFix">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fixRound &lt; 2</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_I_SendFix_I_WaitFix" sourceRef="I_SendFix" targetRef="I_WaitFix" />
      <bpmn:sequenceFlow id="Flow_I_WaitFix_I_LoopMerge" sourceRef="I_WaitFix" targetRef="I_LoopMerge" />
      <bpmn:sequenceFlow id="Flow_I_BRemind_I_Remind" sourceRef="I_BRemind" targetRef="I_Remind" />
      <bpmn:sequenceFlow id="Flow_I_Remind_I_RemEnd" sourceRef="I_Remind" targetRef="I_RemEnd" />
      <bpmn:sequenceFlow id="Flow_I_Rounds_I_Manual" name="No" sourceRef="I_Rounds" targetRef="I_Manual" />
      <bpmn:sequenceFlow id="Flow_I_Manual_I_ManualOk" sourceRef="I_Manual" targetRef="I_ManualOk" />
      <bpmn:sequenceFlow id="Flow_I_ManualOk_I_EndAccepted" name="Yes" sourceRef="I_ManualOk" targetRef="I_EndAccepted">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=intakeAccepted = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_I_ManualOk_I_EndRejected" sourceRef="I_ManualOk" targetRef="I_EndRejected" />
      <bpmn:textAnnotation id="Note_Intake"><bpmn:text>F02 same meter already has an open case: closed as duplicate.
F03 missing info: fix request, up to 2 rounds, then manual review.
F04 reminder after 3 days, case closes after 7 days.
F05 installer not in the registry (or licence expired): treated as missing info.</bpmn:text></bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_Classify" name="Classify (F06)">
      <bpmn:incoming>Flow_Sub_Intake_Sub_Classify</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Classify_Gw_Small</bpmn:outgoing>
      <bpmn:startEvent id="C_Start" name="Classify started">
        <bpmn:outgoing>Flow_C_Start_C_Dmn</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="C_Dmn" name="Size, documents, fee, priority (DMN)">
        <bpmn:extensionElements><zeebe:calledDecision decisionId="ApplicationClassification" resultVariable="classification" bindingType="deployment" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_C_Start_C_Dmn</bpmn:incoming>
        <bpmn:outgoing>Flow_C_Dmn_C_Match</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="C_Match" name="Rule matched? (F06)" default="Flow_C_Match_C_Manual">
        <bpmn:incoming>Flow_C_Dmn_C_Match</bpmn:incoming>
        <bpmn:outgoing>Flow_C_Match_C_Merge</bpmn:outgoing>
        <bpmn:outgoing>Flow_C_Match_C_Manual</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="C_Manual" name="Classify manually">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="manual-classification" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="connection-desk" /><zeebe:ioMapping><zeebe:output source="=context put(classification, &quot;sizeClass&quot;, manualSizeClass)" target="classification" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_C_Match_C_Manual</bpmn:incoming>
        <bpmn:outgoing>Flow_C_Manual_C_Merge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="C_Merge">
        <bpmn:incoming>Flow_C_Match_C_Merge</bpmn:incoming>
        <bpmn:incoming>Flow_C_Manual_C_Merge</bpmn:incoming>
        <bpmn:outgoing>Flow_C_Merge_C_End</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="C_End" name="Classified">
        <bpmn:incoming>Flow_C_Merge_C_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_C_Start_C_Dmn" sourceRef="C_Start" targetRef="C_Dmn" />
      <bpmn:sequenceFlow id="Flow_C_Dmn_C_Match" sourceRef="C_Dmn" targetRef="C_Match" />
      <bpmn:sequenceFlow id="Flow_C_Match_C_Merge" name="Yes" sourceRef="C_Match" targetRef="C_Merge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=classification.sizeClass != &quot;UNKNOWN&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_C_Match_C_Manual" name="No" sourceRef="C_Match" targetRef="C_Manual" />
      <bpmn:sequenceFlow id="Flow_C_Manual_C_Merge" sourceRef="C_Manual" targetRef="C_Merge" />
      <bpmn:sequenceFlow id="Flow_C_Merge_C_End" sourceRef="C_Merge" targetRef="C_End" />
      <bpmn:textAnnotation id="Note_Classify"><bpmn:text>One DRD with 4 tables: size class (UNIQUE), required documents (COLLECT), connection fee in Rs (COLLECT SUM), priority (PRIORITY).
F06 no size rule matches (bad or missing inverter size): a person classifies it instead of an incident.</bpmn:text></bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gw_Small" name="Tiny system? (F07)" default="Flow_Gw_Small_Sub_Technical">
      <bpmn:incoming>Flow_Sub_Classify_Gw_Small</bpmn:incoming>
      <bpmn:outgoing>Flow_Gw_Small_Task_RegisterOnly</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gw_Small_Sub_Technical</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RegisterOnly" name="Register only (fast path)">
      <bpmn:extensionElements><zeebe:taskDefinition type="register-only" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Gw_Small_Task_RegisterOnly</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RegisterOnly_End_Registered</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Registered" name="Registered (F07)">
      <bpmn:incoming>Flow_Task_RegisterOnly_End_Registered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_Technical" name="Technical check (F08-13)">
      <bpmn:extensionElements><zeebe:ioMapping><zeebe:input source="=0" target="solarAttempt" /></zeebe:ioMapping></bpmn:extensionElements>
      <bpmn:incoming>Flow_Gw_Small_Sub_Technical</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Technical_Gw_Overload</bpmn:outgoing>
      <bpmn:startEvent id="T_Start" name="Check started">
        <bpmn:outgoing>Flow_T_Start_T_RetryMerge</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="T_RetryMerge">
        <bpmn:incoming>Flow_T_Start_T_RetryMerge</bpmn:incoming>
        <bpmn:incoming>Flow_T_Backoff_T_RetryMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_T_RetryMerge_T_Weather</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_Weather" name="Estimate solar (weather API)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source="=config.weatherUrl" target="url" /><zeebe:input source="={latitude: string(site.lat), longitude: string(site.lon), hourly: &quot;global_tilted_irradiance&quot;, tilt: &quot;20&quot;, forecast_days: &quot;1&quot;}" target="queryParameters" /><zeebe:input source="false" target="storeResponse" /><zeebe:input source="false" target="followRedirects" /><zeebe:input source="10" target="connectionTimeoutInSeconds" /><zeebe:input source="10" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="13" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" /><zeebe:header key="resultExpression" value="={solar: if response.body.hourly = null then null else {peakKw: max(response.body.hourly.global_tilted_irradiance) / 1000 * system.pvKw * 0.8, source: &quot;WEATHER_API&quot;}}" /><zeebe:header key="retryBackoff" value="PT0S" /><zeebe:header key="errorExpression" value="=if error != null then bpmnError(&quot;SOLAR_API_FAILED&quot;, error.message) else null" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_T_RetryMerge_T_Weather</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Weather_T_Plausible</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="T_BWeather" name="API down (F08)" attachedToRef="T_Weather">
        <bpmn:outgoing>Flow_T_BWeather_T_FailMerge</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_9" errorRef="Error_Solar" />
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="T_Plausible" name="Plausible? (F09)" default="Flow_T_Plausible_T_FailMerge">
        <bpmn:incoming>Flow_T_Weather_T_Plausible</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Plausible_T_YieldMerge</bpmn:outgoing>
        <bpmn:outgoing>Flow_T_Plausible_T_FailMerge</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="T_FailMerge">
        <bpmn:incoming>Flow_T_Plausible_T_FailMerge</bpmn:incoming>
        <bpmn:incoming>Flow_T_BWeather_T_FailMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_T_FailMerge_T_RetryLeft</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="T_RetryLeft" name="Retry left?" default="Flow_T_RetryLeft_T_FbDmn">
        <bpmn:incoming>Flow_T_FailMerge_T_RetryLeft</bpmn:incoming>
        <bpmn:outgoing>Flow_T_RetryLeft_T_Backoff</bpmn:outgoing>
        <bpmn:outgoing>Flow_T_RetryLeft_T_FbDmn</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="T_Backoff" name="Wait, then retry">
        <bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=solarAttempt + 1" target="solarAttempt" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_T_RetryLeft_T_Backoff</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Backoff_T_RetryMerge</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_10"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=timers.retryWait</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:businessRuleTask id="T_FbDmn" name="Fallback yield table (DMN)">
        <bpmn:extensionElements><zeebe:calledDecision decisionId="FallbackYield" resultVariable="fallbackYield" bindingType="deployment" /><zeebe:ioMapping><zeebe:output source="=if fallbackYield = null then null else {peakKw: system.pvKw * fallbackYield.peakFactor, annualKwh: system.pvKw * fallbackYield.specificYield, source: &quot;FALLBACK_TABLE&quot;}" target="solar" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_T_RetryLeft_T_FbDmn</bpmn:incoming>
        <bpmn:outgoing>Flow_T_FbDmn_T_FbHit</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="T_FbHit" name="Found?" default="Flow_T_FbHit_T_Manual">
        <bpmn:incoming>Flow_T_FbDmn_T_FbHit</bpmn:incoming>
        <bpmn:outgoing>Flow_T_FbHit_T_FbMerge</bpmn:outgoing>
        <bpmn:outgoing>Flow_T_FbHit_T_Manual</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_Manual" name="Manual solar estimate">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="manual-solar-estimate" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="grid-engineers" /><zeebe:ioMapping><zeebe:output source="={peakKw: manualPeakKw, annualKwh: manualAnnualKwh, source: &quot;MANUAL&quot;}" target="solar" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_T_FbHit_T_Manual</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Manual_T_FbMerge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="T_FbMerge">
        <bpmn:incoming>Flow_T_FbHit_T_FbMerge</bpmn:incoming>
        <bpmn:incoming>Flow_T_Manual_T_FbMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_T_FbMerge_T_YieldMerge</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="T_YieldMerge">
        <bpmn:incoming>Flow_T_Plausible_T_YieldMerge</bpmn:incoming>
        <bpmn:incoming>Flow_T_FbMerge_T_YieldMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_T_YieldMerge_T_Fetch</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_Fetch" name="Fetch substation load (F10)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source="=config.gridUrl + &quot;/substations/&quot; + site.substationId" target="url" /><zeebe:input source="false" target="storeResponse" /><zeebe:input source="false" target="followRedirects" /><zeebe:input source="10" target="connectionTimeoutInSeconds" /><zeebe:input source="10" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="13" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" /><zeebe:header key="resultExpression" value="={grid: {currentLoadKw: response.body.currentLoadKw, capacityKw: response.body.capacityKw}}" /><zeebe:header key="retryBackoff" value="PT10S" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_T_YieldMerge_T_Fetch</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Fetch_T_LoadDmn</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:businessRuleTask id="T_LoadDmn" name="Grid load status (DMN)">
        <bpmn:extensionElements><zeebe:calledDecision decisionId="GridLoadStatus" resultVariable="gridLoadStatus" bindingType="deployment" /><zeebe:ioMapping><zeebe:input source="=(grid.currentLoadKw + system.inverterKw) / grid.capacityKw * 100" target="projectedLoadPct" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_T_Fetch_T_LoadDmn</bpmn:incoming>
        <bpmn:outgoing>Flow_T_LoadDmn_T_Reserve</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:serviceTask id="T_Reserve" name="Reserve capacity">
        <bpmn:extensionElements><zeebe:taskDefinition type="capacity-reserve" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_T_LoadDmn_T_Reserve</bpmn:incoming>
        <bpmn:outgoing>Flow_T_Reserve_T_CapMerge</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="T_BReserve" name="Taken (F12)" attachedToRef="T_Reserve">
        <bpmn:outgoing>Flow_T_BReserve_T_CapReview</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_11" errorRef="Error_Capacity" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="T_CapReview" name="Engineer: limit or reject">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="capacity-review" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="grid-engineers" /><zeebe:ioMapping><zeebe:output source="=capacityDecision = &quot;LIMIT&quot;" target="exportLimited" /><zeebe:output source="=exportLimitKw" target="exportLimitKw" /><zeebe:output source="=capacityDecision" target="capacityDecision" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_T_BReserve_T_CapReview</bpmn:incoming>
        <bpmn:outgoing>Flow_T_CapReview_T_CapOk</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="T_CapOk" name="Limit export?" default="Flow_T_CapOk_T_EndCap">
        <bpmn:incoming>Flow_T_CapReview_T_CapOk</bpmn:incoming>
        <bpmn:outgoing>Flow_T_CapOk_T_CapMerge</bpmn:outgoing>
        <bpmn:outgoing>Flow_T_CapOk_T_EndCap</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="T_EndCap" name="Closed: no capacity">
        <bpmn:incoming>Flow_T_CapOk_T_EndCap</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_12" errorRef="Error_Closed" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="T_CapMerge">
        <bpmn:incoming>Flow_T_Reserve_T_CapMerge</bpmn:incoming>
        <bpmn:incoming>Flow_T_CapOk_T_CapMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_T_CapMerge_T_HasBat</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="T_HasBat" name="Has battery?" default="Flow_T_HasBat_T_BatMerge">
        <bpmn:incoming>Flow_T_CapMerge_T_HasBat</bpmn:incoming>
        <bpmn:outgoing>Flow_T_HasBat_T_BatDmn</bpmn:outgoing>
        <bpmn:outgoing>Flow_T_HasBat_T_BatMerge</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:businessRuleTask id="T_BatDmn" name="Battery check (DMN)">
        <bpmn:extensionElements><zeebe:calledDecision decisionId="BatteryCheck" resultVariable="batteryOk" bindingType="deployment" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_T_HasBat_T_BatDmn</bpmn:incoming>
        <bpmn:outgoing>Flow_T_BatDmn_T_BatOk</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="T_BatOk" name="Battery OK? (F13)" default="Flow_T_BatOk_T_BatReview">
        <bpmn:incoming>Flow_T_BatDmn_T_BatOk</bpmn:incoming>
        <bpmn:outgoing>Flow_T_BatOk_T_BatMerge</bpmn:outgoing>
        <bpmn:outgoing>Flow_T_BatOk_T_BatReview</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_BatReview" name="Engineer battery review">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="battery-review" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="grid-engineers" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_T_BatOk_T_BatReview</bpmn:incoming>
        <bpmn:outgoing>Flow_T_BatReview_T_BatRevOk</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="T_BatRevOk" name="Accept?" default="Flow_T_BatRevOk_T_EndBat">
        <bpmn:incoming>Flow_T_BatReview_T_BatRevOk</bpmn:incoming>
        <bpmn:outgoing>Flow_T_BatRevOk_T_BatMerge</bpmn:outgoing>
        <bpmn:outgoing>Flow_T_BatRevOk_T_EndBat</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="T_EndBat" name="Closed: battery unsafe">
        <bpmn:incoming>Flow_T_BatRevOk_T_EndBat</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_13" errorRef="Error_Closed" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="T_BatMerge">
        <bpmn:incoming>Flow_T_HasBat_T_BatMerge</bpmn:incoming>
        <bpmn:incoming>Flow_T_BatOk_T_BatMerge</bpmn:incoming>
        <bpmn:incoming>Flow_T_BatRevOk_T_BatMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_T_BatMerge_T_End</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="T_End" name="Check done">
        <bpmn:incoming>Flow_T_BatMerge_T_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_T_Start_T_RetryMerge" sourceRef="T_Start" targetRef="T_RetryMerge" />
      <bpmn:sequenceFlow id="Flow_T_RetryMerge_T_Weather" sourceRef="T_RetryMerge" targetRef="T_Weather" />
      <bpmn:sequenceFlow id="Flow_T_Weather_T_Plausible" sourceRef="T_Weather" targetRef="T_Plausible" />
      <bpmn:sequenceFlow id="Flow_T_Plausible_T_YieldMerge" name="Yes" sourceRef="T_Plausible" targetRef="T_YieldMerge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=solar != null and solar.peakKw != null and solar.peakKw &gt; 0 and solar.peakKw &lt;= system.pvKw * 1.2</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_T_Plausible_T_FailMerge" sourceRef="T_Plausible" targetRef="T_FailMerge" />
      <bpmn:sequenceFlow id="Flow_T_BWeather_T_FailMerge" sourceRef="T_BWeather" targetRef="T_FailMerge" />
      <bpmn:sequenceFlow id="Flow_T_FailMerge_T_RetryLeft" sourceRef="T_FailMerge" targetRef="T_RetryLeft" />
      <bpmn:sequenceFlow id="Flow_T_RetryLeft_T_Backoff" name="Yes" sourceRef="T_RetryLeft" targetRef="T_Backoff">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=solarAttempt &lt; 2</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_T_Backoff_T_RetryMerge" sourceRef="T_Backoff" targetRef="T_RetryMerge" />
      <bpmn:sequenceFlow id="Flow_T_RetryLeft_T_FbDmn" name="No" sourceRef="T_RetryLeft" targetRef="T_FbDmn" />
      <bpmn:sequenceFlow id="Flow_T_FbDmn_T_FbHit" sourceRef="T_FbDmn" targetRef="T_FbHit" />
      <bpmn:sequenceFlow id="Flow_T_FbHit_T_FbMerge" name="Yes" sourceRef="T_FbHit" targetRef="T_FbMerge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=solar != null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_T_FbHit_T_Manual" name="No" sourceRef="T_FbHit" targetRef="T_Manual" />
      <bpmn:sequenceFlow id="Flow_T_Manual_T_FbMerge" sourceRef="T_Manual" targetRef="T_FbMerge" />
      <bpmn:sequenceFlow id="Flow_T_FbMerge_T_YieldMerge" sourceRef="T_FbMerge" targetRef="T_YieldMerge" />
      <bpmn:sequenceFlow id="Flow_T_YieldMerge_T_Fetch" sourceRef="T_YieldMerge" targetRef="T_Fetch" />
      <bpmn:sequenceFlow id="Flow_T_Fetch_T_LoadDmn" sourceRef="T_Fetch" targetRef="T_LoadDmn" />
      <bpmn:sequenceFlow id="Flow_T_LoadDmn_T_Reserve" sourceRef="T_LoadDmn" targetRef="T_Reserve" />
      <bpmn:sequenceFlow id="Flow_T_Reserve_T_CapMerge" sourceRef="T_Reserve" targetRef="T_CapMerge" />
      <bpmn:sequenceFlow id="Flow_T_BReserve_T_CapReview" sourceRef="T_BReserve" targetRef="T_CapReview" />
      <bpmn:sequenceFlow id="Flow_T_CapReview_T_CapOk" sourceRef="T_CapReview" targetRef="T_CapOk" />
      <bpmn:sequenceFlow id="Flow_T_CapOk_T_CapMerge" name="Yes" sourceRef="T_CapOk" targetRef="T_CapMerge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=capacityDecision = &quot;LIMIT&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_T_CapOk_T_EndCap" sourceRef="T_CapOk" targetRef="T_EndCap" />
      <bpmn:sequenceFlow id="Flow_T_CapMerge_T_HasBat" sourceRef="T_CapMerge" targetRef="T_HasBat" />
      <bpmn:sequenceFlow id="Flow_T_HasBat_T_BatDmn" name="Yes" sourceRef="T_HasBat" targetRef="T_BatDmn">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hasBattery = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_T_HasBat_T_BatMerge" name="No" sourceRef="T_HasBat" targetRef="T_BatMerge" />
      <bpmn:sequenceFlow id="Flow_T_BatDmn_T_BatOk" sourceRef="T_BatDmn" targetRef="T_BatOk" />
      <bpmn:sequenceFlow id="Flow_T_BatOk_T_BatMerge" name="Yes" sourceRef="T_BatOk" targetRef="T_BatMerge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=batteryOk = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_T_BatOk_T_BatReview" name="No" sourceRef="T_BatOk" targetRef="T_BatReview" />
      <bpmn:sequenceFlow id="Flow_T_BatReview_T_BatRevOk" sourceRef="T_BatReview" targetRef="T_BatRevOk" />
      <bpmn:sequenceFlow id="Flow_T_BatRevOk_T_BatMerge" name="Yes" sourceRef="T_BatRevOk" targetRef="T_BatMerge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=batteryAccepted = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_T_BatRevOk_T_EndBat" sourceRef="T_BatRevOk" targetRef="T_EndBat" />
      <bpmn:sequenceFlow id="Flow_T_BatMerge_T_End" sourceRef="T_BatMerge" targetRef="T_End" />
      <bpmn:textAnnotation id="Note_Solar"><bpmn:text>Solar estimate fallback chain:
F08 weather API down -&gt; wait and retry (2 times) -&gt; region table (DMN) -&gt; engineer estimate.
F09 API answers nonsense (empty, wrong units) -&gt; treated like a failure.</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="Note_Grid"><bpmn:text>F10 grid service down: 3 retries, then an incident in Operate (fix and retry).
F11 overload is decided here (DMN) and handled by the Transformer upgrade stage.
F12 another case took the last capacity: engineer limits export or rejects.
F13 battery fails the DMN check: engineer review.</bpmn:text></bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gw_Overload" name="Overloaded? (F11)" default="Flow_Gw_Overload_Gw_UpMerge">
      <bpmn:incoming>Flow_Sub_Technical_Gw_Overload</bpmn:incoming>
      <bpmn:outgoing>Flow_Gw_Overload_Sub_Upgrade</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gw_Overload_Gw_UpMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_Upgrade" name="Transformer upgrade (F14-16)">
      <bpmn:incoming>Flow_Gw_Overload_Sub_Upgrade</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Upgrade_Gw_UpMerge</bpmn:outgoing>
      <bpmn:startEvent id="U_Start" name="Upgrade needed">
        <bpmn:outgoing>Flow_U_Start_U_Plan</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="U_Plan" name="Plan upgrade + cost (Rs)">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="upgrade-plan" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="grid-engineers" /><zeebe:ioMapping><zeebe:output source="={option: upgradeOption, costRs: upgradeCostRs, applicantShareRs: applicantShareRs}" target="upgrade" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_U_Start_U_Plan</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Plan_U_Offer</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="U_Offer" name="Send cost offer">
        <bpmn:extensionElements><zeebe:taskDefinition type="portal-request" /><zeebe:taskHeaders><zeebe:header key="requestType" value="COST_OFFER" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_U_Plan_U_Offer</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Offer_U_Wait</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="U_Wait">
        <bpmn:incoming>Flow_U_Offer_U_Wait</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Wait_U_Accepted</bpmn:outgoing>
        <bpmn:outgoing>Flow_U_Wait_U_Declined</bpmn:outgoing>
        <bpmn:outgoing>Flow_U_Wait_U_Expiry</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="U_Accepted" name="Offer accepted">
        <bpmn:incoming>Flow_U_Wait_U_Accepted</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Accepted_U_Order</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_14" messageRef="Msg_OfferAccepted" />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="U_Order" name="Order transformer">
        <bpmn:extensionElements><zeebe:taskDefinition type="transformer-order" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_U_Accepted_U_Order</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Order_U_OrderMerge</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="U_BStock" name="Out of stock (F15)" attachedToRef="U_Order">
        <bpmn:outgoing>Flow_U_BStock_U_Alt</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_15" errorRef="Error_Stock" />
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="U_BComp" name="Undo" attachedToRef="U_Order">
        <bpmn:compensateEventDefinition id="CompensateEventDefinition_16" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="U_Cancel" name="Cancel transformer order" isForCompensation="true">
        <bpmn:extensionElements><zeebe:taskDefinition type="transformer-cancel" /></bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:userTask id="U_Alt" name="Order from 2nd supplier">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="alternate-supplier" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="grid-engineers" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_U_BStock_U_Alt</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Alt_U_OrderMerge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="U_OrderMerge">
        <bpmn:incoming>Flow_U_Order_U_OrderMerge</bpmn:incoming>
        <bpmn:incoming>Flow_U_Alt_U_OrderMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_U_OrderMerge_U_WaitDel</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:receiveTask id="U_WaitDel" name="Wait for delivery" messageRef="Msg_Delivered">
        <bpmn:incoming>Flow_U_OrderMerge_U_WaitDel</bpmn:incoming>
        <bpmn:outgoing>Flow_U_WaitDel_U_Install</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="U_BLate" name="Too late (F16)" attachedToRef="U_WaitDel">
        <bpmn:outgoing>Flow_U_BLate_U_Undo</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_17"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=timers.delivery</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:intermediateThrowEvent id="U_Undo" name="Undo the order">
        <bpmn:incoming>Flow_U_BLate_U_Undo</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Undo_U_LimitMerge</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="CompensateEventDefinition_18" />
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="U_Install" name="Install transformer">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="upgrade-install" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="grid-engineers" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_U_WaitDel_U_Install</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Install_U_Recheck</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:businessRuleTask id="U_Recheck" name="Recheck grid load (DMN)">
        <bpmn:extensionElements><zeebe:calledDecision decisionId="GridLoadStatus" resultVariable="gridLoadStatus" bindingType="deployment" /><zeebe:ioMapping><zeebe:input source="=(grid.currentLoadKw + system.inverterKw) / newCapacityKw * 100" target="projectedLoadPct" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_U_Install_U_Recheck</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Recheck_U_End</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:endEvent id="U_End" name="Upgrade done">
        <bpmn:incoming>Flow_U_Recheck_U_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="U_Declined" name="Offer declined (F14)">
        <bpmn:incoming>Flow_U_Wait_U_Declined</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Declined_U_LimitMerge</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_19" messageRef="Msg_OfferDeclined" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="U_Expiry" name="No answer (F14)">
        <bpmn:incoming>Flow_U_Wait_U_Expiry</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Expiry_U_LimitMerge</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_20"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=timers.offerExpiry</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="U_LimitMerge">
        <bpmn:incoming>Flow_U_Declined_U_LimitMerge</bpmn:incoming>
        <bpmn:incoming>Flow_U_Undo_U_LimitMerge</bpmn:incoming>
        <bpmn:incoming>Flow_U_Expiry_U_LimitMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_U_LimitMerge_U_Limit</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="U_Limit" name="Set export limit (fallback)">
        <bpmn:extensionElements><zeebe:taskDefinition type="export-limit" /><zeebe:ioMapping><zeebe:output source="=true" target="exportLimited" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_U_LimitMerge_U_Limit</bpmn:incoming>
        <bpmn:outgoing>Flow_U_Limit_U_EndLimited</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="U_EndLimited" name="Connect with limit">
        <bpmn:incoming>Flow_U_Limit_U_EndLimited</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_U_Start_U_Plan" sourceRef="U_Start" targetRef="U_Plan" />
      <bpmn:sequenceFlow id="Flow_U_Plan_U_Offer" sourceRef="U_Plan" targetRef="U_Offer" />
      <bpmn:sequenceFlow id="Flow_U_Offer_U_Wait" sourceRef="U_Offer" targetRef="U_Wait" />
      <bpmn:sequenceFlow id="Flow_U_Wait_U_Accepted" sourceRef="U_Wait" targetRef="U_Accepted" />
      <bpmn:sequenceFlow id="Flow_U_Accepted_U_Order" sourceRef="U_Accepted" targetRef="U_Order" />
      <bpmn:sequenceFlow id="Flow_U_Order_U_OrderMerge" sourceRef="U_Order" targetRef="U_OrderMerge" />
      <bpmn:sequenceFlow id="Flow_U_BStock_U_Alt" sourceRef="U_BStock" targetRef="U_Alt" />
      <bpmn:sequenceFlow id="Flow_U_Alt_U_OrderMerge" sourceRef="U_Alt" targetRef="U_OrderMerge" />
      <bpmn:sequenceFlow id="Flow_U_OrderMerge_U_WaitDel" sourceRef="U_OrderMerge" targetRef="U_WaitDel" />
      <bpmn:sequenceFlow id="Flow_U_WaitDel_U_Install" sourceRef="U_WaitDel" targetRef="U_Install" />
      <bpmn:sequenceFlow id="Flow_U_Install_U_Recheck" sourceRef="U_Install" targetRef="U_Recheck" />
      <bpmn:sequenceFlow id="Flow_U_Recheck_U_End" sourceRef="U_Recheck" targetRef="U_End" />
      <bpmn:sequenceFlow id="Flow_U_BLate_U_Undo" sourceRef="U_BLate" targetRef="U_Undo" />
      <bpmn:sequenceFlow id="Flow_U_Wait_U_Declined" sourceRef="U_Wait" targetRef="U_Declined" />
      <bpmn:sequenceFlow id="Flow_U_Wait_U_Expiry" sourceRef="U_Wait" targetRef="U_Expiry" />
      <bpmn:sequenceFlow id="Flow_U_Declined_U_LimitMerge" sourceRef="U_Declined" targetRef="U_LimitMerge" />
      <bpmn:sequenceFlow id="Flow_U_Undo_U_LimitMerge" sourceRef="U_Undo" targetRef="U_LimitMerge" />
      <bpmn:sequenceFlow id="Flow_U_Expiry_U_LimitMerge" sourceRef="U_Expiry" targetRef="U_LimitMerge" />
      <bpmn:sequenceFlow id="Flow_U_LimitMerge_U_Limit" sourceRef="U_LimitMerge" targetRef="U_Limit" />
      <bpmn:sequenceFlow id="Flow_U_Limit_U_EndLimited" sourceRef="U_Limit" targetRef="U_EndLimited" />
      <bpmn:association id="Assoc_U_BComp_U_Cancel" associationDirection="One" sourceRef="U_BComp" targetRef="U_Cancel" />
      <bpmn:textAnnotation id="Note_Upgrade"><bpmn:text>Q25 sub-process: Grid Transformer Capacity Upgrade.
F14 applicant refuses (or ignores) the cost share -&gt; connect with an export limit instead.
F15 supplier out of stock -&gt; order from a second supplier.
F16 delivery too late -&gt; compensation undoes the order (Cancel transformer order) -&gt; export limit.</bpmn:text></bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gw_UpMerge">
      <bpmn:incoming>Flow_Gw_Overload_Gw_UpMerge</bpmn:incoming>
      <bpmn:incoming>Flow_Sub_Upgrade_Gw_UpMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_Gw_UpMerge_Sub_Inspections</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_Inspections" name="Inspect each device (F17-21)">
      <bpmn:extensionElements><zeebe:ioMapping><zeebe:input source="=null" target="inspectionResult" /><zeebe:input source="=null" target="checklist" /><zeebe:input source="=0" target="fixRound" /><zeebe:input source="=null" target="certificateOverride" /></zeebe:ioMapping></bpmn:extensionElements>
      <bpmn:incoming>Flow_Gw_UpMerge_Sub_Inspections</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Inspections_Sub_Approval</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=devices" inputElement="device" outputCollection="inspectionResults" outputElement="=inspectionResult" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="D_Start" name="Device inspection">
        <bpmn:outgoing>Flow_D_Start_D_Cert</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="D_Cert" name="Check device certificate" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source="=config.certUrl + &quot;/&quot; + device.certificateId" target="url" /><zeebe:input source="false" target="storeResponse" /><zeebe:input source="false" target="followRedirects" /><zeebe:input source="10" target="connectionTimeoutInSeconds" /><zeebe:input source="10" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="13" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" /><zeebe:header key="resultExpression" value="={certificateCheck: response.body}" /><zeebe:header key="retryBackoff" value="PT10S" /><zeebe:header key="errorExpression" value="=if error != null and error.code = &quot;404&quot; then bpmnError(&quot;CERT_INVALID&quot;, &quot;Certificate not found&quot;) else if error = null and list contains([&quot;EXPIRED&quot;, &quot;REVOKED&quot;], response.body.status) then bpmnError(&quot;CERT_INVALID&quot;, &quot;Certificate &quot; + response.body.status) else null" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_D_Start_D_Cert</bpmn:incoming>
        <bpmn:outgoing>Flow_D_Cert_D_CertMerge</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="D_BCert" name="Invalid (F17)" attachedToRef="D_Cert">
        <bpmn:outgoing>Flow_D_BCert_D_GetCert</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_21" errorRef="Error_Cert" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="D_GetCert" name="Get valid certificate">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="certificate-request" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="connection-desk" /><zeebe:ioMapping><zeebe:output source="=newCertificateId" target="certificateOverride" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_D_BCert_D_GetCert</bpmn:incoming>
        <bpmn:outgoing>Flow_D_GetCert_D_CertMerge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="D_CertMerge">
        <bpmn:incoming>Flow_D_Cert_D_CertMerge</bpmn:incoming>
        <bpmn:incoming>Flow_D_GetCert_D_CertMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_D_CertMerge_D_Checklist</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:businessRuleTask id="D_Checklist" name="Build checklist (DMN)">
        <bpmn:extensionElements><zeebe:calledDecision decisionId="InspectionChecklist" resultVariable="checklist" bindingType="deployment" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_D_CertMerge_D_Checklist</bpmn:incoming>
        <bpmn:outgoing>Flow_D_Checklist_D_Book</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:serviceTask id="D_Book" name="Book inspector">
        <bpmn:extensionElements><zeebe:taskDefinition type="inspection-book" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_D_Checklist_D_Book</bpmn:incoming>
        <bpmn:outgoing>Flow_D_Book_D_BookMerge</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="D_BBook" name="None free (F18)" attachedToRef="D_Book">
        <bpmn:outgoing>Flow_D_BBook_D_Partner</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_22" errorRef="Error_NoInspector" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="D_Partner" name="Partner inspector or video check">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="partner-inspection" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="field-inspectors" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_D_BBook_D_Partner</bpmn:incoming>
        <bpmn:outgoing>Flow_D_Partner_D_BookMerge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="D_BookMerge">
        <bpmn:incoming>Flow_D_Book_D_BookMerge</bpmn:incoming>
        <bpmn:incoming>Flow_D_Partner_D_BookMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_D_BookMerge_D_ReMerge</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="D_ReMerge">
        <bpmn:incoming>Flow_D_BookMerge_D_ReMerge</bpmn:incoming>
        <bpmn:incoming>Flow_D_Fixed_D_ReMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_D_ReMerge_D_Inspect</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="D_Inspect" name="Safety inspection">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="safety-inspection" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="field-inspectors" /><zeebe:ioMapping><zeebe:output source="={serialNumber: device.serialNumber, type: device.type, outcome: inspectionOutcome, insulationMOhm: insulationMOhm, earthOhm: earthOhm, notes: inspectionNotes}" target="inspectionResult" /></zeebe:ioMapping></bpmn:extensionElements>
        <bpmn:incoming>Flow_D_ReMerge_D_Inspect</bpmn:incoming>
        <bpmn:outgoing>Flow_D_Inspect_D_Result</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="D_BOver" name="Overdue (F19)" attachedToRef="D_Inspect" cancelActivity="false">
        <bpmn:outgoing>Flow_D_BOver_D_Esc</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_23"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=timers.inspectionOverdue</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:intermediateThrowEvent id="D_Esc" name="Alert supervisor">
        <bpmn:incoming>Flow_D_BOver_D_Esc</bpmn:incoming>
        <bpmn:outgoing>Flow_D_Esc_D_EscEnd</bpmn:outgoing>
        <bpmn:escalationEventDefinition id="EscalationEventDefinition_24" escalationRef="Esc_Overdue" />
      </bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="D_EscEnd" name="Supervisor alerted">
        <bpmn:incoming>Flow_D_Esc_D_EscEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="D_Result" name="Result?" default="Flow_D_Result_D_EndPass">
        <bpmn:incoming>Flow_D_Inspect_D_Result</bpmn:incoming>
        <bpmn:outgoing>Flow_D_Result_D_EndPass</bpmn:outgoing>
        <bpmn:outgoing>Flow_D_Result_D_FirstFix</bpmn:outgoing>
        <bpmn:outgoing>Flow_D_Result_D_EndCritical</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="D_EndPass" name="Passed">
        <bpmn:incoming>Flow_D_Result_D_EndPass</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="D_EndCritical" name="Critical defect (F21)">
        <bpmn:incoming>Flow_D_Result_D_EndCritical</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_25" errorRef="Error_Closed" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="D_FirstFix" name="First fix?" default="Flow_D_FirstFix_D_EndFailed">
        <bpmn:incoming>Flow_D_Result_D_FirstFix</bpmn:incoming>
        <bpmn:outgoing>Flow_D_FirstFix_D_ReqFix</bpmn:outgoing>
        <bpmn:outgoing>Flow_D_FirstFix_D_EndFailed</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="D_ReqFix" name="Request fix">
        <bpmn:extensionElements><zeebe:taskDefinition type="portal-request" /><zeebe:ioMapping><zeebe:output source="=fixRound + 1" target="fixRound" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="requestType" value="DEFECT_FIX" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_D_FirstFix_D_ReqFix</bpmn:incoming>
        <bpmn:outgoing>Flow_D_ReqFix_D_Fixed</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="D_Fixed" name="Fix done">
        <bpmn:incoming>Flow_D_ReqFix_D_Fixed</bpmn:incoming>
        <bpmn:outgoing>Flow_D_Fixed_D_ReMerge</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_26" messageRef="Msg_DefectFixed" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="D_EndFailed" name="Device failed">
        <bpmn:incoming>Flow_D_FirstFix_D_EndFailed</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_D_Start_D_Cert" sourceRef="D_Start" targetRef="D_Cert" />
      <bpmn:sequenceFlow id="Flow_D_Cert_D_CertMerge" sourceRef="D_Cert" targetRef="D_CertMerge" />
      <bpmn:sequenceFlow id="Flow_D_BCert_D_GetCert" sourceRef="D_BCert" targetRef="D_GetCert" />
      <bpmn:sequenceFlow id="Flow_D_GetCert_D_CertMerge" sourceRef="D_GetCert" targetRef="D_CertMerge" />
      <bpmn:sequenceFlow id="Flow_D_CertMerge_D_Checklist" sourceRef="D_CertMerge" targetRef="D_Checklist" />
      <bpmn:sequenceFlow id="Flow_D_Checklist_D_Book" sourceRef="D_Checklist" targetRef="D_Book" />
      <bpmn:sequenceFlow id="Flow_D_Book_D_BookMerge" sourceRef="D_Book" targetRef="D_BookMerge" />
      <bpmn:sequenceFlow id="Flow_D_BBook_D_Partner" sourceRef="D_BBook" targetRef="D_Partner" />
      <bpmn:sequenceFlow id="Flow_D_Partner_D_BookMerge" sourceRef="D_Partner" targetRef="D_BookMerge" />
      <bpmn:sequenceFlow id="Flow_D_BookMerge_D_ReMerge" sourceRef="D_BookMerge" targetRef="D_ReMerge" />
      <bpmn:sequenceFlow id="Flow_D_ReMerge_D_Inspect" sourceRef="D_ReMerge" targetRef="D_Inspect" />
      <bpmn:sequenceFlow id="Flow_D_Inspect_D_Result" sourceRef="D_Inspect" targetRef="D_Result" />
      <bpmn:sequenceFlow id="Flow_D_BOver_D_Esc" sourceRef="D_BOver" targetRef="D_Esc" />
      <bpmn:sequenceFlow id="Flow_D_Esc_D_EscEnd" sourceRef="D_Esc" targetRef="D_EscEnd" />
      <bpmn:sequenceFlow id="Flow_D_Result_D_EndPass" name="Pass" sourceRef="D_Result" targetRef="D_EndPass" />
      <bpmn:sequenceFlow id="Flow_D_Result_D_FirstFix" name="Minor (F20)" sourceRef="D_Result" targetRef="D_FirstFix">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=inspectionOutcome = &quot;MINOR&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_D_Result_D_EndCritical" name="Critical" sourceRef="D_Result" targetRef="D_EndCritical">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=inspectionOutcome = &quot;CRITICAL&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_D_FirstFix_D_ReqFix" name="Yes" sourceRef="D_FirstFix" targetRef="D_ReqFix">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fixRound &lt; 1</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_D_FirstFix_D_EndFailed" sourceRef="D_FirstFix" targetRef="D_EndFailed" />
      <bpmn:sequenceFlow id="Flow_D_ReqFix_D_Fixed" sourceRef="D_ReqFix" targetRef="D_Fixed" />
      <bpmn:sequenceFlow id="Flow_D_Fixed_D_ReMerge" sourceRef="D_Fixed" targetRef="D_ReMerge" />
      <bpmn:textAnnotation id="Note_Insp"><bpmn:text>Q25 multi-instance: this runs once per inverter or battery, all in parallel (parallel for over &quot;devices&quot;).
F17 certificate invalid -&gt; ask for a valid one.  F18 no inspector -&gt; partner or video check.
F19 overdue -&gt; supervisor alerted (does not stop the work).  F20 minor defect -&gt; fix and re-inspect once.
F21 critical defect -&gt; error stops ALL parallel inspections and closes the case.</bpmn:text></bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_Approval" name="Approval (F22-24)">
      <bpmn:incoming>Flow_Sub_Inspections_Sub_Approval</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Approval_Call_SmartMeter</bpmn:outgoing>
      <bpmn:startEvent id="A_Start" name="Approval started">
        <bpmn:outgoing>Flow_A_Start_A_Combine</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:scriptTask id="A_Combine" name="Combine inspection results">
        <bpmn:extensionElements><zeebe:script expression="=every r in inspectionResults satisfies r != null and r.outcome = &quot;PASS&quot;" resultVariable="allPassed" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_A_Start_A_Combine</bpmn:incoming>
        <bpmn:outgoing>Flow_A_Combine_A_AllPass</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="A_AllPass" name="All devices passed? (F22)" default="Flow_A_AllPass_A_Partial">
        <bpmn:incoming>Flow_A_Combine_A_AllPass</bpmn:incoming>
        <bpmn:outgoing>Flow_A_AllPass_A_PMerge</bpmn:outgoing>
        <bpmn:outgoing>Flow_A_AllPass_A_Partial</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A_Partial" name="Decide: fewer devices or reject">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="partial-approval" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="compliance" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_A_AllPass_A_Partial</bpmn:incoming>
        <bpmn:outgoing>Flow_A_Partial_A_PartialOk</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A_PartialOk" name="Continue?" default="Flow_A_PartialOk_A_EndPartial">
        <bpmn:incoming>Flow_A_Partial_A_PartialOk</bpmn:incoming>
        <bpmn:outgoing>Flow_A_PartialOk_A_PMerge</bpmn:outgoing>
        <bpmn:outgoing>Flow_A_PartialOk_A_EndPartial</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="A_EndPartial" name="Closed: devices failed">
        <bpmn:incoming>Flow_A_PartialOk_A_EndPartial</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_27" errorRef="Error_Closed" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="A_PMerge">
        <bpmn:incoming>Flow_A_AllPass_A_PMerge</bpmn:incoming>
        <bpmn:incoming>Flow_A_PartialOk_A_PMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_A_PMerge_A_Dmn</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:businessRuleTask id="A_Dmn" name="Final approval (DMN)">
        <bpmn:extensionElements><zeebe:calledDecision decisionId="FinalApproval" resultVariable="approval" bindingType="deployment" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_A_PMerge_A_Dmn</bpmn:incoming>
        <bpmn:outgoing>Flow_A_Dmn_A_Decision</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="A_Decision" name="Decision?" default="Flow_A_Decision_A_AMerge">
        <bpmn:incoming>Flow_A_Dmn_A_Decision</bpmn:incoming>
        <bpmn:outgoing>Flow_A_Decision_A_AMerge</bpmn:outgoing>
        <bpmn:outgoing>Flow_A_Decision_A_EndReject</bpmn:outgoing>
        <bpmn:outgoing>Flow_A_Decision_A_First</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="A_EndReject" name="Closed: rejected">
        <bpmn:incoming>Flow_A_Decision_A_EndReject</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_28" errorRef="Error_Closed" />
      </bpmn:endEvent>
      <bpmn:userTask id="A_First" name="First compliance review">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="first-review" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="compliance" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_A_Decision_A_First</bpmn:incoming>
        <bpmn:outgoing>Flow_A_First_A_SecondMerge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A_SecondMerge">
        <bpmn:incoming>Flow_A_First_A_SecondMerge</bpmn:incoming>
        <bpmn:incoming>Flow_A_SameP_A_SecondMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_A_SecondMerge_A_FourEyes</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A_FourEyes" name="Second approver review">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="second-approval" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="compliance" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_A_SecondMerge_A_FourEyes</bpmn:incoming>
        <bpmn:outgoing>Flow_A_FourEyes_A_SameP</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A_SameP" name="Same person? (F23)" default="Flow_A_SameP_A_Approved">
        <bpmn:incoming>Flow_A_FourEyes_A_SameP</bpmn:incoming>
        <bpmn:outgoing>Flow_A_SameP_A_SecondMerge</bpmn:outgoing>
        <bpmn:outgoing>Flow_A_SameP_A_Approved</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="A_Approved" name="Approved?" default="Flow_A_Approved_A_EndManual">
        <bpmn:incoming>Flow_A_SameP_A_Approved</bpmn:incoming>
        <bpmn:outgoing>Flow_A_Approved_A_AMerge</bpmn:outgoing>
        <bpmn:outgoing>Flow_A_Approved_A_EndManual</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="A_EndManual" name="Closed: not approved">
        <bpmn:incoming>Flow_A_Approved_A_EndManual</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_29" errorRef="Error_Closed" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="A_AMerge">
        <bpmn:incoming>Flow_A_Decision_A_AMerge</bpmn:incoming>
        <bpmn:incoming>Flow_A_Approved_A_AMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_A_AMerge_A_Cert</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_Cert" name="Generate certificate">
        <bpmn:extensionElements><zeebe:taskDefinition type="certificate-generate" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_A_AMerge_A_Cert</bpmn:incoming>
        <bpmn:outgoing>Flow_A_Cert_A_Email</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A_Email" name="Email certificate" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="4">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="1" /><zeebe:ioMapping><zeebe:input source="smtp" target="protocol" /><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="=config.smtpHost" target="data.smtpConfig.smtpHost" /><zeebe:input source="=config.smtpPort" target="data.smtpConfig.smtpPort" /><zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="=config.mailFrom" target="data.smtpAction.from" /><zeebe:input source="=applicant.email" target="data.smtpAction.to" /><zeebe:input source="=&quot;Connection approved: &quot; + applicationId" target="data.smtpAction.subject" /><zeebe:input source="PLAIN" target="data.smtpAction.contentType" /><zeebe:input source="=&quot;Dear &quot; + applicant.name + &quot;,

your solar connection &quot; + applicationId + &quot; is approved.
Compliance certificate: &quot; + certificate.id + &quot;

Next step: smart meter installation and the feed-in tariff contract.

Metro City Power&quot;" target="data.smtpAction.body" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="4" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" /><zeebe:header key="resultVariable" value="emailResult" /><zeebe:header key="retryBackoff" value="PT5S" /><zeebe:header key="errorExpression" value="=if error != null then bpmnError(&quot;EMAIL_FAILED&quot;, error.message) else null" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_A_Cert_A_Email</bpmn:incoming>
        <bpmn:outgoing>Flow_A_Email_A_EMerge</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="A_BEmail" name="Email failed (F24)" attachedToRef="A_Email">
        <bpmn:outgoing>Flow_A_BEmail_A_Portal</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_30" errorRef="Error_Email" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A_Portal" name="Portal inbox + manual post">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="manual-post" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="connection-desk" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_A_BEmail_A_Portal</bpmn:incoming>
        <bpmn:outgoing>Flow_A_Portal_A_EMerge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A_EMerge">
        <bpmn:incoming>Flow_A_Email_A_EMerge</bpmn:incoming>
        <bpmn:incoming>Flow_A_Portal_A_EMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_A_EMerge_A_End</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="A_End" name="Certificate sent">
        <bpmn:incoming>Flow_A_EMerge_A_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A_Start_A_Combine" sourceRef="A_Start" targetRef="A_Combine" />
      <bpmn:sequenceFlow id="Flow_A_Combine_A_AllPass" sourceRef="A_Combine" targetRef="A_AllPass" />
      <bpmn:sequenceFlow id="Flow_A_AllPass_A_PMerge" name="Yes" sourceRef="A_AllPass" targetRef="A_PMerge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=allPassed = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_A_AllPass_A_Partial" name="No" sourceRef="A_AllPass" targetRef="A_Partial" />
      <bpmn:sequenceFlow id="Flow_A_Partial_A_PartialOk" sourceRef="A_Partial" targetRef="A_PartialOk" />
      <bpmn:sequenceFlow id="Flow_A_PartialOk_A_PMerge" name="Yes" sourceRef="A_PartialOk" targetRef="A_PMerge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=partialContinue = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_A_PartialOk_A_EndPartial" sourceRef="A_PartialOk" targetRef="A_EndPartial" />
      <bpmn:sequenceFlow id="Flow_A_PMerge_A_Dmn" sourceRef="A_PMerge" targetRef="A_Dmn" />
      <bpmn:sequenceFlow id="Flow_A_Dmn_A_Decision" sourceRef="A_Dmn" targetRef="A_Decision" />
      <bpmn:sequenceFlow id="Flow_A_Decision_A_AMerge" name="Auto approve" sourceRef="A_Decision" targetRef="A_AMerge" />
      <bpmn:sequenceFlow id="Flow_A_Decision_A_EndReject" name="Reject" sourceRef="A_Decision" targetRef="A_EndReject">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approval.decision = &quot;REJECT&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_A_Decision_A_First" name="Manual" sourceRef="A_Decision" targetRef="A_First">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approval.decision = &quot;MANUAL_REVIEW&quot;</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_A_First_A_SecondMerge" sourceRef="A_First" targetRef="A_SecondMerge" />
      <bpmn:sequenceFlow id="Flow_A_SecondMerge_A_FourEyes" sourceRef="A_SecondMerge" targetRef="A_FourEyes" />
      <bpmn:sequenceFlow id="Flow_A_FourEyes_A_SameP" sourceRef="A_FourEyes" targetRef="A_SameP" />
      <bpmn:sequenceFlow id="Flow_A_SameP_A_SecondMerge" name="Yes: reassign" sourceRef="A_SameP" targetRef="A_SecondMerge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=secondApproverId = firstApproverId</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_A_SameP_A_Approved" name="No" sourceRef="A_SameP" targetRef="A_Approved" />
      <bpmn:sequenceFlow id="Flow_A_Approved_A_AMerge" name="Yes" sourceRef="A_Approved" targetRef="A_AMerge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=firstApproved = true and secondApproved = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_A_Approved_A_EndManual" sourceRef="A_Approved" targetRef="A_EndManual" />
      <bpmn:sequenceFlow id="Flow_A_AMerge_A_Cert" sourceRef="A_AMerge" targetRef="A_Cert" />
      <bpmn:sequenceFlow id="Flow_A_Cert_A_Email" sourceRef="A_Cert" targetRef="A_Email" />
      <bpmn:sequenceFlow id="Flow_A_Email_A_EMerge" sourceRef="A_Email" targetRef="A_EMerge" />
      <bpmn:sequenceFlow id="Flow_A_BEmail_A_Portal" sourceRef="A_BEmail" targetRef="A_Portal" />
      <bpmn:sequenceFlow id="Flow_A_Portal_A_EMerge" sourceRef="A_Portal" targetRef="A_EMerge" />
      <bpmn:sequenceFlow id="Flow_A_EMerge_A_End" sourceRef="A_EMerge" targetRef="A_End" />
      <bpmn:textAnnotation id="Note_Appr"><bpmn:text>F22 some devices failed -&gt; compliance approves fewer devices or rejects.
F23 four-eyes: the second approver must be a different person, otherwise the task is reassigned.
F24 certificate email fails (Email connector error) -&gt; portal inbox and posted by hand.</bpmn:text></bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:callActivity id="Call_SmartMeter" name="Smart meter + contract (F25-26)">
      <bpmn:extensionElements><zeebe:calledElement processId="smart-meter-contract" propagateAllChildVariables="false" /><zeebe:ioMapping><zeebe:input source="=applicationId" target="applicationId" /><zeebe:input source="=applicant" target="applicant" /><zeebe:input source="=site" target="site" /><zeebe:input source="=system" target="system" /><zeebe:input source="=timers" target="timers" /><zeebe:input source="=config" target="config" /><zeebe:output source="=tariff" target="tariff" /><zeebe:output source="=meterSerial" target="meterSerial" /><zeebe:output source="=esignStatus" target="contractStatus" /></zeebe:ioMapping></bpmn:extensionElements>
      <bpmn:incoming>Flow_Sub_Approval_Call_SmartMeter</bpmn:incoming>
      <bpmn:outgoing>Flow_Call_SmartMeter_End_Connected</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="End_Connected" name="Connected">
      <bpmn:incoming>Flow_Call_SmartMeter_End_Connected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ZeroExport" name="Connect without selling power">
      <bpmn:extensionElements><zeebe:taskDefinition type="zero-export-setup" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_B_Declined_Task_ZeroExport</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ZeroExport_End_NoExport</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_NoExport" name="Connected (no export)">
      <bpmn:incoming>Flow_Task_ZeroExport_End_NoExport</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Catch_Close" name="Close case">
      <bpmn:outgoing>Flow_Catch_Close_Task_NotifyClosed</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LinkEventDefinition_31" name="close-case" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_NotifyClosed" name="Email closure notice" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="4">
      <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="1" /><zeebe:ioMapping><zeebe:input source="smtp" target="protocol" /><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="=config.smtpHost" target="data.smtpConfig.smtpHost" /><zeebe:input source="=config.smtpPort" target="data.smtpConfig.smtpPort" /><zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="=config.mailFrom" target="data.smtpAction.from" /><zeebe:input source="=applicant.email" target="data.smtpAction.to" /><zeebe:input source="=&quot;Application &quot; + applicationId + &quot; closed&quot;" target="data.smtpAction.subject" /><zeebe:input source="PLAIN" target="data.smtpAction.contentType" /><zeebe:input source="=&quot;Dear &quot; + applicant.name + &quot;,

your solar connection application &quot; + applicationId + &quot; has been closed&quot; + (if closeReason != null then &quot; (&quot; + closeReason + &quot;)&quot; else &quot;&quot;) + &quot;.
Please contact the Metro City Power connection desk for details.

Metro City Power&quot;" target="data.smtpAction.body" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="4" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" /><zeebe:header key="resultVariable" value="emailResult" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements>
      <bpmn:incoming>Flow_Catch_Close_Task_NotifyClosed</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_NotifyClosed_End_Closed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Closed" name="Case closed">
      <bpmn:incoming>Flow_Task_NotifyClosed_End_Closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Esp_Withdraw" name="Applicant withdraws (F27)" triggeredByEvent="true">
      <bpmn:startEvent id="W_Start" name="Withdrawal received (F27)">
        <bpmn:outgoing>Flow_W_Start_W_Undo</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_32" messageRef="Msg_Withdraw" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="W_Undo" name="Undo completed work">
        <bpmn:incoming>Flow_W_Start_W_Undo</bpmn:incoming>
        <bpmn:outgoing>Flow_W_Undo_W_Cleanup</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="CompensateEventDefinition_33" />
      </bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="W_Cleanup" name="Cancel open bookings">
        <bpmn:extensionElements><zeebe:taskDefinition type="case-cleanup" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_W_Undo_W_Cleanup</bpmn:incoming>
        <bpmn:outgoing>Flow_W_Cleanup_W_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W_End" name="Withdrawn">
        <bpmn:incoming>Flow_W_Cleanup_W_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_W_Start_W_Undo" sourceRef="W_Start" targetRef="W_Undo" />
      <bpmn:sequenceFlow id="Flow_W_Undo_W_Cleanup" sourceRef="W_Undo" targetRef="W_Cleanup" />
      <bpmn:sequenceFlow id="Flow_W_Cleanup_W_End" sourceRef="W_Cleanup" targetRef="W_End" />
      <bpmn:textAnnotation id="Note_Esp_Withdraw"><bpmn:text>Interrupting: the applicant can withdraw at any time. Compensation undoes finished work (e.g. a transformer order), the worker cancels open bookings.</bpmn:text></bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:subProcess id="Esp_Deadline" name="Deadline warning (F29)" triggeredByEvent="true">
      <bpmn:startEvent id="L_Start" name="Day 18 of 20 (F29)" isInterrupting="false">
        <bpmn:outgoing>Flow_L_Start_L_Review</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_34"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=timers.deadlineWarn</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:userTask id="L_Review" name="Supervisor reviews delay">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="delay-review" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="supervisors" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_L_Start_L_Review</bpmn:incoming>
        <bpmn:outgoing>Flow_L_Review_L_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="L_End" name="Reviewed">
        <bpmn:incoming>Flow_L_Review_L_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_L_Start_L_Review" sourceRef="L_Start" targetRef="L_Review" />
      <bpmn:sequenceFlow id="Flow_L_Review_L_End" sourceRef="L_Review" targetRef="L_End" />
      <bpmn:textAnnotation id="Note_Esp_Deadline"><bpmn:text>Non-interrupting: the case keeps running, a supervisor is warned before the 20-day target.</bpmn:text></bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:subProcess id="Esp_Error" name="Unexpected error (F30)" triggeredByEvent="true">
      <bpmn:startEvent id="X_Start" name="Any unexpected error (F30)">
        <bpmn:outgoing>Flow_X_Start_X_Log</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_35" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="X_Log" name="Log error + alert ops">
        <bpmn:extensionElements><zeebe:taskDefinition type="ops-alert" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_X_Start_X_Log</bpmn:incoming>
        <bpmn:outgoing>Flow_X_Log_X_Ops</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="X_Ops" name="Ops: review error">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="ops-triage" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="ops" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_X_Log_X_Ops</bpmn:incoming>
        <bpmn:outgoing>Flow_X_Ops_X_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="X_End" name="Parked">
        <bpmn:incoming>Flow_X_Ops_X_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_X_Start_X_Log" sourceRef="X_Start" targetRef="X_Log" />
      <bpmn:sequenceFlow id="Flow_X_Log_X_Ops" sourceRef="X_Log" targetRef="X_Ops" />
      <bpmn:sequenceFlow id="Flow_X_Ops_X_End" sourceRef="X_Ops" targetRef="X_End" />
      <bpmn:textAnnotation id="Note_Esp_Error"><bpmn:text>Catch-all: any BPMN error nobody planned for parks the case for the ops team instead of leaving it stuck.</bpmn:text></bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:subProcess id="Esp_Emergency" name="Grid emergency (F28)" triggeredByEvent="true">
      <bpmn:startEvent id="E_Start" name="Grid emergency (F28)" isInterrupting="false">
        <bpmn:outgoing>Flow_E_Start_E_Pause</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDefinition_36" signalRef="Sig_Emergency" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="E_Pause" name="Pause field work">
        <bpmn:extensionElements><zeebe:taskDefinition type="field-pause" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_E_Start_E_Pause</bpmn:incoming>
        <bpmn:outgoing>Flow_E_Pause_E_Lifted</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="E_Lifted" name="Emergency lifted">
        <bpmn:incoming>Flow_E_Pause_E_Lifted</bpmn:incoming>
        <bpmn:outgoing>Flow_E_Lifted_E_Resume</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDefinition_37" signalRef="Sig_Lifted" />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="E_Resume" name="Resume field work">
        <bpmn:extensionElements><zeebe:taskDefinition type="field-resume" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_E_Lifted_E_Resume</bpmn:incoming>
        <bpmn:outgoing>Flow_E_Resume_E_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E_End" name="Resumed">
        <bpmn:incoming>Flow_E_Resume_E_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_E_Start_E_Pause" sourceRef="E_Start" targetRef="E_Pause" />
      <bpmn:sequenceFlow id="Flow_E_Pause_E_Lifted" sourceRef="E_Pause" targetRef="E_Lifted" />
      <bpmn:sequenceFlow id="Flow_E_Lifted_E_Resume" sourceRef="E_Lifted" targetRef="E_Resume" />
      <bpmn:sequenceFlow id="Flow_E_Resume_E_End" sourceRef="E_Resume" targetRef="E_End" />
      <bpmn:textAnnotation id="Note_Esp_Emergency"><bpmn:text>Signal = broadcast to every running case at once. Non-interrupting: field work pauses, then resumes.</bpmn:text></bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_IntakeClosed" name="Case closed" attachedToRef="Sub_Intake">
      <bpmn:outgoing>Flow_B_IntakeClosed_Throw_B_IntakeClosed</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_38" errorRef="Error_Closed" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Throw_B_IntakeClosed" name="Close case">
      <bpmn:incoming>Flow_B_IntakeClosed_Throw_B_IntakeClosed</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_39" name="close-case" />
    </bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="B_TechClosed" name="Case closed" attachedToRef="Sub_Technical">
      <bpmn:outgoing>Flow_B_TechClosed_Throw_B_TechClosed</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_40" errorRef="Error_Closed" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Throw_B_TechClosed" name="Close case">
      <bpmn:incoming>Flow_B_TechClosed_Throw_B_TechClosed</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_41" name="close-case" />
    </bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="B_InspClosed" name="Case closed" attachedToRef="Sub_Inspections">
      <bpmn:outgoing>Flow_B_InspClosed_Throw_B_InspClosed</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_42" errorRef="Error_Closed" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Throw_B_InspClosed" name="Close case">
      <bpmn:incoming>Flow_B_InspClosed_Throw_B_InspClosed</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_43" name="close-case" />
    </bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="B_ApprClosed" name="Case closed" attachedToRef="Sub_Approval">
      <bpmn:outgoing>Flow_B_ApprClosed_Throw_B_ApprClosed</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_44" errorRef="Error_Closed" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Throw_B_ApprClosed" name="Close case">
      <bpmn:incoming>Flow_B_ApprClosed_Throw_B_ApprClosed</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_45" name="close-case" />
    </bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="B_Expired" name="Unsigned (F25)" attachedToRef="Call_SmartMeter">
      <bpmn:outgoing>Flow_B_Expired_Throw_B_Expired</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_46" errorRef="Error_Expired" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Throw_B_Expired" name="Close case">
      <bpmn:incoming>Flow_B_Expired_Throw_B_Expired</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_47" name="close-case" />
    </bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="B_Declined" name="Declined (F26)" attachedToRef="Call_SmartMeter">
      <bpmn:outgoing>Flow_B_Declined_Task_ZeroExport</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_48" errorRef="Error_Declined" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_B_IntakeClosed_Throw_B_IntakeClosed" sourceRef="B_IntakeClosed" targetRef="Throw_B_IntakeClosed" />
    <bpmn:sequenceFlow id="Flow_B_TechClosed_Throw_B_TechClosed" sourceRef="B_TechClosed" targetRef="Throw_B_TechClosed" />
    <bpmn:sequenceFlow id="Flow_B_InspClosed_Throw_B_InspClosed" sourceRef="B_InspClosed" targetRef="Throw_B_InspClosed" />
    <bpmn:sequenceFlow id="Flow_B_ApprClosed_Throw_B_ApprClosed" sourceRef="B_ApprClosed" targetRef="Throw_B_ApprClosed" />
    <bpmn:sequenceFlow id="Flow_B_Expired_Throw_B_Expired" sourceRef="B_Expired" targetRef="Throw_B_Expired" />
    <bpmn:sequenceFlow id="Flow_Start_Applied_Task_Setup" sourceRef="Start_Applied" targetRef="Task_Setup" />
    <bpmn:sequenceFlow id="Flow_Task_Setup_Sub_Intake" sourceRef="Task_Setup" targetRef="Sub_Intake" />
    <bpmn:sequenceFlow id="Flow_Sub_Intake_Sub_Classify" sourceRef="Sub_Intake" targetRef="Sub_Classify" />
    <bpmn:sequenceFlow id="Flow_Sub_Classify_Gw_Small" sourceRef="Sub_Classify" targetRef="Gw_Small" />
    <bpmn:sequenceFlow id="Flow_Gw_Small_Task_RegisterOnly" name="Yes" sourceRef="Gw_Small" targetRef="Task_RegisterOnly">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=classification.sizeClass = &quot;MICRO&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Task_RegisterOnly_End_Registered" sourceRef="Task_RegisterOnly" targetRef="End_Registered" />
    <bpmn:sequenceFlow id="Flow_Gw_Small_Sub_Technical" name="No" sourceRef="Gw_Small" targetRef="Sub_Technical" />
    <bpmn:sequenceFlow id="Flow_Sub_Technical_Gw_Overload" sourceRef="Sub_Technical" targetRef="Gw_Overload" />
    <bpmn:sequenceFlow id="Flow_Gw_Overload_Sub_Upgrade" name="Yes" sourceRef="Gw_Overload" targetRef="Sub_Upgrade">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=gridLoadStatus = &quot;OVERLOAD&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gw_Overload_Gw_UpMerge" name="No" sourceRef="Gw_Overload" targetRef="Gw_UpMerge" />
    <bpmn:sequenceFlow id="Flow_Sub_Upgrade_Gw_UpMerge" sourceRef="Sub_Upgrade" targetRef="Gw_UpMerge" />
    <bpmn:sequenceFlow id="Flow_Gw_UpMerge_Sub_Inspections" sourceRef="Gw_UpMerge" targetRef="Sub_Inspections" />
    <bpmn:sequenceFlow id="Flow_Sub_Inspections_Sub_Approval" sourceRef="Sub_Inspections" targetRef="Sub_Approval" />
    <bpmn:sequenceFlow id="Flow_Sub_Approval_Call_SmartMeter" sourceRef="Sub_Approval" targetRef="Call_SmartMeter" />
    <bpmn:sequenceFlow id="Flow_Call_SmartMeter_End_Connected" sourceRef="Call_SmartMeter" targetRef="End_Connected" />
    <bpmn:sequenceFlow id="Flow_B_Declined_Task_ZeroExport" sourceRef="B_Declined" targetRef="Task_ZeroExport" />
    <bpmn:sequenceFlow id="Flow_Task_ZeroExport_End_NoExport" sourceRef="Task_ZeroExport" targetRef="End_NoExport" />
    <bpmn:sequenceFlow id="Flow_Catch_Close_Task_NotifyClosed" sourceRef="Catch_Close" targetRef="Task_NotifyClosed" />
    <bpmn:sequenceFlow id="Flow_Task_NotifyClosed_End_Closed" sourceRef="Task_NotifyClosed" targetRef="End_Closed" />
    <bpmn:textAnnotation id="Note_Legend"><bpmn:text>Legend
green task = Java job worker
blue task = REST connector
purple task = DMN decision
orange task = user task (Tasklist form)
teal = waiting for a message or timer
grey task = notification (email / portal)
yellow task = FEEL script
box with + = stage, click to open its failure paths</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Close"><bpmn:text>Every rejection inside a stage ends with the error CASE_CLOSED. The boundary event catches it and jumps to one shared &quot;Close case&quot; path (link events).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Timers"><bpmn:text>Timers read their duration from the variable &quot;timers&quot; (set by &quot;Set case defaults&quot;). demoMode = true turns days into minutes for the live demo.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Tiny"><bpmn:text>MICRO systems (up to 1 kW) skip the technical check and inspections: register only (F07).</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:message id="Msg_Submitted" name="application-submitted" />
  <bpmn:message id="Msg_Fix" name="fix-submitted"><bpmn:extensionElements><zeebe:subscription correlationKey="=applicationId" /></bpmn:extensionElements></bpmn:message>
  <bpmn:message id="Msg_Withdraw" name="application-withdrawn"><bpmn:extensionElements><zeebe:subscription correlationKey="=applicationId" /></bpmn:extensionElements></bpmn:message>
  <bpmn:message id="Msg_OfferAccepted" name="cost-offer-accepted"><bpmn:extensionElements><zeebe:subscription correlationKey="=applicationId" /></bpmn:extensionElements></bpmn:message>
  <bpmn:message id="Msg_OfferDeclined" name="cost-offer-declined"><bpmn:extensionElements><zeebe:subscription correlationKey="=applicationId" /></bpmn:extensionElements></bpmn:message>
  <bpmn:message id="Msg_Delivered" name="transformer-delivered"><bpmn:extensionElements><zeebe:subscription correlationKey="=applicationId" /></bpmn:extensionElements></bpmn:message>
  <bpmn:message id="Msg_DefectFixed" name="defect-fixed"><bpmn:extensionElements><zeebe:subscription correlationKey="=applicationId + &quot;:&quot; + device.serialNumber" /></bpmn:extensionElements></bpmn:message>
