# Demo values for docker-compose.yml (all synthetic). Copy to .env to override; .env is git-ignored.
# docker-compose.yml falls back to these same defaults when no .env exists.

# PostgreSQL (portal-api, profile "postgres")
DB_NAME=portal
DB_USER=portal
DB_PASSWORD=portal

# Camunda 8.10 c8run on the host
CAMUNDA_URL=http://host.docker.internal:8080
CAMUNDA_REST_URL=http://host.docker.internal:8080
CAMUNDA_GRPC_URL=http://host.docker.internal:26500
CAMUNDA_USER=demo
CAMUNDA_PASSWORD=demo
CONNECTORS_URL=http://host.docker.internal:8086

# mock-services. Must match the c8run connector secrets of the same name
# (SECRET_MOCKS_API_KEY / SECRET_ESIGN_HMAC_SECRET in the connector runtime environment).
MOCKS_API_KEY=demo-mocks-key
ESIGN_HMAC_SECRET=demo-esign-secret
ESIGN_WEBHOOK_URL=http://host.docker.internal:8086/inbound/mcp-esign-callback

# portal-api CORS (comma-separated)
PORTAL_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
