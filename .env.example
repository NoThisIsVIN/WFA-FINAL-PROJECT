# Copy to .env and fill in. Never commit .env.
# Camunda 8.10 c8run (local, unprotected API)
CAMUNDA_REST_ADDRESS=http://localhost:8080
CAMUNDA_GRPC_ADDRESS=http://localhost:26500
CAMUNDA_USER=demo
CAMUNDA_PASSWORD=demo

# Mailpit (SMTP sink)
SMTP_HOST=localhost
SMTP_PORT=1025

# Connector secrets (read by the connectors runtime as {{secrets.NAME}})
GC_WEBHOOK_B2B_API_KEY=change-me
GC_ESIGN_HMAC_SECRET=change-me
GC_COMMISSIONING_HMAC_SECRET=change-me

# Local services
PORTAL_API_URL=http://localhost:8090
MOCK_SERVICES_URL=http://localhost:8091
DEMO_MODE=true
